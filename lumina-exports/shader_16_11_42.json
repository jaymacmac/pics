  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_sparkle;\nuniform float u_glow;\nuniform float u_hue;   \nuniform float u_hue2;  \nuniform float u_neuro_complexity; \nuniform float u_chromatic_aberration; \nuniform float u_bass; \nuniform float u_glitch_intensity; \nuniform float u_rage_intensity; \nuniform float u_distortion_warp; \n\nout vec4 fragColor;\n\n// --- SEAMLESS MATH HELPERS ---\n\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Loop-safe FBM: uses a circular path for the noise offset\nfloat fbm(vec2 p, float t) {\n    float v = 0.0;\n    float a = 0.5;\n    float loopTime = 300.0;\n    // Circular noise offset ensures start matches end\n    float angle = (t / loopTime) * 6.2831853;\n    vec2 shift = vec2(cos(angle), sin(angle)) * 2.0; \n    \n    for (int i = 0; i < 4; ++i) {\n        v += a * (sin(p.x + shift.x) + sin(p.y + shift.y));\n        p = rot(0.5) * p * 2.1 + shift;\n        a *= 0.5;\n    }\n    return v;\n}\n\nvec3 hsb2rgb(vec3 c) {\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\nvec3 getLayerColor(int i, float hue1, float hue2) {\n    float t = float(i) / 9.0; \n    float h = mix(hue1, hue2, t);\n    float sat = mix(0.8, 1.0, u_rage_intensity);\n    float bri = mix(0.4, 1.2, t);\n    return hsb2rgb(vec3(h, sat, bri));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // --- CONTINUOUS 5-MINUTE LOOP ---\n    float loopTime = 300.0;\n    float t = mod(iTime, loopTime);\n    float move = t * u_speed;\n    \n    // Neural distortion using the circular noise fix\n    float neural = fbm(uv * (3.0 + u_distortion_warp), t) * (u_neuro_complexity + u_rage_intensity);\n    uv += neural * (0.1 + u_distortion_warp * 0.1);\n\n    vec3 bgCol = hsb2rgb(vec3(mix(u_hue, u_hue2, 0.5), 0.8, 0.02));\n    vec3 finalColor = bgCol;\n\n    for(int i = 0; i < 10; i++) {\n        float layerIndex = float(i);\n        \n        // Locking the wave frequency to the 300s window\n        // Frequency is adjusted so it completes a full rotation\n        float freq = floor((1.5 + layerIndex * 0.1) * 10.0) / 10.0;\n        float waveHeight = sin(uv.x * freq + move + layerIndex) * 0.3; \n        waveHeight *= u_scale;\n        \n        float surfaceY = waveHeight + (-0.7 + (layerIndex * 0.15));\n        float fillMask = smoothstep(0.01, -0.01, uv.y - surfaceY);\n        \n        vec3 col = getLayerColor(i, u_hue, u_hue2);\n        finalColor += col * fillMask * 0.15; \n        \n        float edgeGlow = exp(-abs(uv.y - surfaceY) * 10.0) * u_glow;\n        finalColor += col * edgeGlow * 0.5;\n    }\n\n    finalColor *= 1.2 - length(uv0) * 0.6;\n    finalColor = pow(finalColor, vec3(0.9)); \n    fragColor = vec4(finalColor, 1.0);\n}\n\n/* CONFIG\n{\n  \"parameters\": [\n    { \"name\": \"u_speed\", \"label\": \"Speed\", \"type\": \"float\", \"default\": 0.2, \"min\": 0, \"max\": 5 },\n    { \"name\": \"u_scale\", \"label\": \"Scale\", \"type\": \"float\", \"default\": 3.4, \"min\": 0.1, \"max\": 10 },\n    { \"name\": \"u_glow\", \"label\": \"Glow\", \"type\": \"float\", \"default\": 1.1, \"min\": 0, \"max\": 5 },\n    { \"name\": \"u_hue\", \"label\": \"Hue\", \"type\": \"float\", \"default\": 0.86, \"min\": 0, \"max\": 1 },\n    { \"name\": \"u_hue2\", \"label\": \"Hue2\", \"type\": \"float\", \"default\": 0.67, \"min\": 0, \"max\": 1 },\n    { \"name\": \"u_neuro_complexity\", \"label\": \"Neuro Complexity\", \"type\": \"float\", \"default\": 1.7, \"min\": -5, \"max\": 5 },\n    { \"name\": \"u_distortion_warp\", \"label\": \"Distortion Warp\", \"type\": \"float\", \"default\": 2, \"min\": 0, \"max\": 20 }\n  ]\n}\n*/",
