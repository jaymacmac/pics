  "code": "\n\nout vec4 fragColor;\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Audio Reactivity\nuniform float u_bass;\nuniform float u_mid;\nuniform float u_treble;\nuniform float u_vol;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_nebula_density;\nuniform float u_color_offset;\nuniform float u_star_intensity;\nuniform float u_brightness;\n\n// Constants\n#define ITERATIONS 64\n#define VOLUMETRIC_STEPS 48\n\n// Hash function for noise\nfloat hash(vec3 p) {\n    p = fract(p * 0.3183099 + .1);\n    p *= 17.0;\n    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));\n}\n\n// 3D Noise function\nfloat noise(vec3 x) {\n    vec3 i = floor(x);\n    vec3 f = fract(x);\n    f = f * f * (3.0 - 2.0 * f);\n    \n    return mix(mix(mix(hash(i + vec3(0, 0, 0)), hash(i + vec3(1, 0, 0)), f.x),\n                   mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),\n               mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),\n                   mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);\n}\n\n// Fractional Brownian Motion for nebula clouds\nfloat fbm(vec3 p) {\n    float v = 0.0;\n    float a = 0.5;\n    vec3 shift = vec3(100);\n    for (int i = 0; i < 5; ++i) {\n        v += a * noise(p);\n        p = p * 2.0 + shift;\n        a *= 0.5;\n    }\n    return v;\n}\n\n// Color palette generator\nvec3 getNebulaColor(float t) {\n    t += u_color_offset;\n    vec3 a = vec3(0.5, 0.5, 0.5);\n    vec3 b = vec3(0.5, 0.5, 0.5);\n    vec3 c = vec3(1.0, 1.0, 1.0);\n    vec3 d = vec3(0.1, 0.2, 0.3); // Blue/Purple base\n    \n    // Shift palette towards warm colors based on offset\n    vec3 col = a + b * cos(6.28318 * (c * t + d));\n    return col * vec3(1.2, 0.8, 1.5); // Add slight magenta boost\n}\n\n// Star field function\nvec3 getStars(vec2 uv) {\n    vec3 stars = vec3(0.0);\n    float n = hash(vec3(uv * 1000.0, 1.0));\n    if (n > 0.998) {\n        float starIntensity = pow(hash(vec3(uv * 500.0, 2.0)), 10.0);\n        stars = vec3(starIntensity * u_star_intensity);\n        // Twinkle\n        stars *= 0.8 + 0.2 * sin(iTime * 3.0 + n * 6.28);\n    }\n    return stars;\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 mouse = (iMouse.xy / iResolution.xy) - 0.5;\n    \n    // Camera setup\n    float time = iTime * u_speed * 0.1;\n    vec3 ro = vec3(0.0, 0.0, -3.0); // Ray origin\n    vec3 rd = normalize(vec3(uv, 1.5)); // Ray direction\n    \n    // Rotation\n    float ang = time * 0.2 + mouse.x * 2.0;\n    mat2 rot = mat2(cos(ang), sin(ang), -sin(ang), cos(ang));\n    rd.xz *= rot;\n    rd.yz *= mat2(cos(mouse.y), sin(mouse.y), -sin(mouse.y), cos(mouse.y));\n    ro.xz *= rot;\n\n    // Volumetric rendering\n    vec3 finalColor = vec3(0.0);\n    float transmittance = 1.0;\n    \n    // Start with background stars\n    finalColor += getStars(uv + mouse * 0.1);\n\n    float stepDist = 0.15;\n    vec3 p = ro + rd * 2.0;\n\n    for (int i = 0; i < VOLUMETRIC_STEPS; i++) {\n        // Density calculation\n        float d = fbm(p * 0.5 + time);\n        d = smoothstep(0.3, 0.8, d);\n        \n        // Add audio influence to density\n        d += u_bass * 0.1 * noise(p * 2.0);\n        \n        if (d > 0.01) {\n            float density = d * u_nebula_density;\n            \n            // Lighting: Light coming from a central \"hidden\" star\n            float light = smoothstep(0.0, 1.0, fbm(p * 0.8 + 10.0));\n            \n            // Color mapping based on distance and density\n            vec3 col = getNebulaColor(d + length(p) * 0.1);\n            \n            // Apply scattering/absorption\n            float shadow = exp(-density * stepDist);\n            vec3 stepColor = col * density * light * u_brightness;\n            \n            finalColor += stepColor * transmittance;\n            transmittance *= shadow;\n        }\n        \n        if (transmittance < 0.01) break;\n        \n        p += rd * stepDist;\n    }\n\n    // Add a central glow\n    float glow = 0.03 / (0.01 + dot(uv, uv));\n    finalColor += vec3(0.6, 0.4, 0.9) * glow * 0.05 * (1.0 + u_mid);\n\n    // Tone mapping and gamma correction\n    finalColor = 1.0 - exp(-finalColor);\n    finalColor = pow(finalColor, vec3(0.8));\n\n    fragColor = vec4(finalColor, 1.0);\n}",
