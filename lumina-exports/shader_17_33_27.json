  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \nuniform sampler2D iChannel1; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; // Reused as tunnel radius\nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_tunnel_twist; \nuniform float u_exit_light_size; \nuniform float u_exit_light_bright; \n\n// --- ETHEREAL CONTROLS ---\nuniform float u_ethereal_bloom;\nuniform float u_dither_strength; // Added to help combat banding artifacts\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\n#define PI 3.14159265359\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Pseudo-random function for dithering\nfloat hash12(vec2 p) {\n\tvec3 p3  = fract(vec3(p.xyx) * .1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\n// --- MAIN RENDER LOOP ---\nvoid main() {\n    // 1. Setup UVs and Ray Direction\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // Create the ray direction for a forward-moving perspective\n    vec3 rd = normalize(vec3(uv, 1.0 / u_fov)); \n    \n    // Animation Time\n    float t = iTime * u_speed;\n    \n    // Raymarching Variables\n    vec4 col = vec4(0.0);\n    \n    // 2. DITHERING TO FIX ARTIFACTS\n    // We add a small random offset to the starting distance.\n    // This breaks up the \"scan line\" slices/shards by jittering the step locations.\n    float dither = hash12(gl_FragCoord.xy) * u_dither_strength;\n    float dist = u_camera_dist + dither; \n    \n    float stepSize = 0.0;\n    \n    // --- VOLUMETRIC MARCH ---\n    // Increased step count slightly for smoother integration\n    for(int i = 0; i < 90; i++) {\n        \n        // Current Position along Ray\n        vec3 p = dist * rd;\n        p.z += t; // Forward motion\n        \n        // Apply twist to the tunnel based on depth\n        p.xy *= rot(p.z * u_tunnel_twist + t * 0.1);\n        \n        // --- TURBULENCE LOOP (FBM-ish) ---\n        float scale = 2.5;\n        // We smooth the distortion transitions to avoid harsh artifacts\n        for(int j = 0; j < 4; j++) {\n            p += u_turbulence_strength * sin(p.yzx * scale + t * 0.2) / scale;\n            scale *= 1.6; \n            if (scale > 40.0) break;\n        }\n        \n        // --- CYLINDRICAL DENSITY CALCULATION ---\n        float radius = u_cloud_height * 2.0;\n        float tunnelDist = length(p.xy) - radius;\n        \n        // Calculate Step Size\n        // Using a more conservative step factor to minimize \"sampling shards\"\n        float stepFactor = max(abs(tunnelDist), 0.015);\n        stepSize = stepFactor * 0.4; // Reduced step multiplier for higher precision\n        \n        // Advance Ray\n        dist += stepSize;\n        \n        // --- COLOR ACCUMULATION: ETHEREAL REDS ---\n        float angle = atan(p.y, p.x);\n        \n        // Shift base hue towards the Ethereal Red spectrum\n        vec3 redBase     = vec3(0.4, 0.02, 0.05); // Deep Crimson\n        vec3 orangeBase  = vec3(0.9, 0.3, 0.1);  // Burning Orange\n        vec3 roseBase    = vec3(0.7, 0.2, 0.4);  // Soft Rose\n        \n        // Dynamic mixing\n        float mixVal = sin(p.z * 0.2 + angle + u_color_shift * PI * 2.0) * 0.5 + 0.5;\n        vec3 baseColor = mix(redBase, mix(orangeBase, roseBase, sin(t * 0.5) * 0.5 + 0.5), mixVal);\n        \n        // Glow logic: softened exponential falloff to blend \"shards\"\n        float glow = exp(-abs(tunnelDist) * (6.0 / u_density_factor));\n        \n        // Accumulate intensity\n        float attenuation = 1.0 / (1.0 + dist * 0.15);\n        // Multiplying by stepSize makes the accumulation energy-conserving and smoother\n        col.rgb += baseColor * glow * (u_glow_intensity * 0.1) * attenuation * stepSize;\n        \n        // Optimization\n        if(col.a > 0.99 || dist > 40.0) break;\n    }\n    \n    // --- THE LIGHT AT THE END OF THE TUNNEL (ETHEREAL STAR) ---\n    float distToCenter = length(uv);\n    float exitGlow = pow(max(0.0, 1.0 - distToCenter / u_exit_light_size), 3.0);\n    vec3 exitColor = vec3(1.0, 0.8, 0.6) * exitGlow * u_exit_light_bright;\n    \n    // --- POST PROCESSING ---\n    vec3 finalCol = col.rgb + exitColor;\n    \n    // Add Ethereal Bloom / Haze\n    finalCol += (vec3(1.0, 0.2, 0.3) * u_ethereal_bloom * 0.2) / (1.0 + distToCenter * 4.0);\n    \n    // Contrast and Tone Mapping\n    finalCol = smoothstep(-0.02, 1.25, finalCol);\n    finalCol = pow(finalCol, vec3(0.95)); \n    \n    // Vignette\n    finalCol *= 1.1 - dot(uv, uv) * 0.7;\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
