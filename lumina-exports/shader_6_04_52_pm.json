  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// User Parameters (Preserved and updated for lush green theme)\nuniform float u_speed;\nuniform float u_fov;\nuniform float u_camera_dist;\nuniform float u_glow_intensity;\nuniform float u_complexity; \nuniform float u_viscosity;\nuniform float u_paper_texture;\nuniform float u_metallic_shine;\nuniform float u_bloom_brightness;\nuniform float u_paint_thickness;\nuniform float u_creaminess;\nuniform float u_melting;\nuniform float u_berry_intensity; \nuniform float u_wave_height;\nuniform float u_orange_hue; // Re-purposed for Moss/Emerald Shift\nuniform float u_neon_saturation;\nuniform float u_edge_glow;\nuniform float u_transparency;\nuniform float u_baby_blue_mix; // Re-purposed for Minty/Cyan tint\n\n// Integrated Organic Parameters\nuniform float u_wave_speed;   \nuniform float u_organic_flow;  \nuniform float u_smoothness;    \nuniform float u_fluidity;      \nuniform float u_neural_density;\nuniform float u_foliage_depth; // New parameter for lushness\n\nout vec4 fragColor;\n\n// --- UTILS ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat hash(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = hash(i);\n    float b = hash(i + vec2(1.0, 0.0));\n    float c = hash(i + vec2(0.0, 1.0));\n    float d = hash(i + vec2(1.0, 1.0));\n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// Domain warping from the organic logic\nvec2 domainWarp(vec2 p, float t) {\n    float n1 = noise(p + t * 0.2);\n    float n2 = noise(p + vec2(n1, n1) + t * 0.1);\n    return p + vec2(cos(n2 * 6.28), sin(n2 * 6.28)) * u_fluidity * 0.2;\n}\n\n// Organic distortion helper\nvec2 distort(vec2 p, float t) {\n    p += 0.15 * cos(vec2(t + p.y * 1.5, t + p.x * 1.5) * u_organic_flow);\n    p += 0.1 * sin(vec2(t * 1.2 + p.y * 3.0, t * 0.8 + p.x * 3.5));\n    return p;\n}\n\n// Updated Palette for Lush Greens (Forest, Emerald, Lime, Mint)\nvec3 getLushGreenPalette(float t, float mask) {\n    vec3 deepForest = vec3(0.05, 0.2, 0.1) * u_berry_intensity * u_neon_saturation; \n    vec3 emerald    = vec3(0.0, 0.8, 0.3) * u_berry_intensity * u_neon_saturation; \n    vec3 mintyNeon  = vec3(0.6, 1.0, 0.7) * u_neon_saturation;\n    \n    float selector = sin(t * 1.5 + mask * 4.0) * 0.5 + 0.5;\n    \n    // Mix between dark forest and bright emerald\n    vec3 finalCol = mix(deepForest, emerald, smoothstep(0.1, 0.7, selector));\n    \n    // Mix in minty highlights\n    finalCol = mix(finalCol, mintyNeon, smoothstep(0.7, 1.0, selector) * u_baby_blue_mix);\n    \n    // Mossy/Yellowish shift using the old \"orange_hue\" control\n    vec3 mossShift = vec3(0.6, 0.7, 0.1) * u_neon_saturation;\n    finalCol = mix(finalCol, mossShift, (1.0 - selector) * u_orange_hue);\n    \n    // Add depth based on the new foliage parameter\n    finalCol *= (1.0 - u_foliage_depth * 0.5);\n    \n    return finalCol;\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv_orig = uv;\n    \n    // Zoom control\n    uv *= (3.0 - u_fov); \n    \n    float t = iTime * u_speed * 0.15;\n\n    // Apply Organic Domain Warping\n    uv = domainWarp(uv, t);\n    \n    vec2 p = uv;\n    float flow = 0.0;\n    \n    // Melt effect (slow crawl of vines)\n    p.y -= t * u_melting * 0.25;\n    \n    // Fractal Folding with Organic influence - representing dense foliage structure\n    float waveAmp = u_wave_height;\n    for(float i = 1.0; i <= u_complexity; i++) {\n        p.x += (waveAmp / i) * sin(i * 1.8 * p.y + t + u_viscosity * 4.0);\n        p.y += (waveAmp / i) * cos(i * 1.8 * p.x + t + u_viscosity * 4.0);\n        p *= rot(u_camera_dist * 0.04);\n        flow += length(p - uv);\n    }\n    \n    // Core Distance Field\n    float d = length(sin(p * 0.9)) - 0.45;\n    float mask = smoothstep(1.0 + u_paint_thickness * 0.5, -0.3, d);\n    float edge = exp(-abs(d) * (10.0 - u_edge_glow)) * (u_glow_intensity + 0.5);\n    \n    // Lush Green Palette\n    vec3 baseCol = getLushGreenPalette(flow * 0.12 + t * 0.15, mask);\n    vec3 finalCol = baseCol * mask;\n    finalCol += baseCol * edge * 1.5; \n\n    // Glossy Reflections (Simulating wet leaves/glossy sap)\n    vec3 n = normalize(vec3(dFdx(flow), dFdy(flow), 0.1 / (0.01 + u_wave_height))); \n    vec3 lightDir = normalize(vec3(sin(t * 0.3), 1.0, 1.5));\n    float spec = pow(max(0.0, dot(n, lightDir)), 15.0) * u_metallic_shine;\n    vec3 highlight = vec3(0.9, 1.0, 0.85); // Slightly yellow-white light\n    finalCol += spec * highlight * u_bloom_brightness;\n    \n    // Grain/Dust (Bio-luminescent spores)\n    if (u_paper_texture > 0.0) {\n        float grain = noise(gl_FragCoord.xy * 0.4 + t);\n        float seedPattern = step(0.99 - u_paper_texture * 0.05, noise(p * 20.0 + flow));\n        finalCol += seedPattern * mix(baseCol, highlight, 0.5) * 2.5;\n    }\n\n    // Transparency & Vignette\n    float alpha = clamp(mask + edge * 0.8 + (length(finalCol) * 0.2), 0.0, 1.0) * u_transparency;\n    float vignette = smoothstep(1.6, 0.2, length(uv_orig));\n    finalCol *= vignette;\n    \n    // Slight gamma correction and saturation boost for the greens\n    finalCol = pow(finalCol, vec3(0.9)); \n    fragColor = vec4(finalCol, alpha);\n}",
