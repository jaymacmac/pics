  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\n\n// User Parameters\nuniform float u_speed;        \nuniform float u_thickness;    \nuniform float u_glow;         \nuniform float u_hue_offset;   \nuniform float u_metalness;    // Acts as frost refraction intensity\nuniform float u_gold_mix;     // Acts as Deep Ice/Cyan mix\nuniform float u_frost_amount; // New: Controls the crystalline grain texture\n\nout vec4 fragColor;\n\n// A smoother rotation helper\nmat2 rot(float a) { return mat2(cos(a), -sin(a), sin(a), cos(a)); }\n\n// Simple pseudo-random hash for frost texture\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// Ice and Glacial Palette\nvec3 getIceGlacial(int i, float xPos) {\n    // Bright surface ice (White/Light Blue)\n    vec3 iceSurface = vec3(0.8, 0.95, 1.0);\n    // Deep glacial ice (Deep Teal/Cyan)\n    vec3 iceDeep = vec3(0.0, 0.4, 0.6);\n    \n    // Vary the ice depth based on layer index and horizontal position\n    float mixer = clamp(sin(xPos * 1.5 + float(i)) * 0.5 + 0.5, 0.0, 1.0);\n    mixer = mix(mixer, 1.0, u_gold_mix); \n    \n    return mix(iceSurface, iceDeep, mixer);\n}\n\nvoid main() {\n    // Corrected UVs to maintain aspect ratio\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / min(iResolution.y, iResolution.x);\n    vec2 uv0 = uv;\n\n    float time = iTime * u_speed;\n    \n    // Dark Glacial Chasm Background\n    vec3 finalColor = vec3(0.01, 0.03, 0.06); \n\n    // Crystalline noise for the frost effect\n    float frost = hash(uv * 500.0) * u_frost_amount;\n\n    // 5 Layers of \"Glacial Ribbons\"\n    for(int i = 0; i < 5; i++) {\n        float f = float(i);\n        \n        // --- WAVE LOGIC (Sharper, more jagged for ice) ---\n        float wave = sin(uv.x * 1.5 + time + f * 1.5) * 0.2;\n        wave += cos(uv.x * 4.3 - time * 0.7 + f) * 0.05; // Added sharper harmonic\n        \n        // Subtle vertical oscillation\n        float yOffset = -0.4 + (f * 0.2) + sin(time * 0.5 + f) * 0.1;\n        \n        // Distance to the wave line\n        float dist = abs(uv.y - (wave + yOffset));\n\n        // --- ICE RENDERING ---\n        // Frosty falloff for the glowing ice core\n        float bloom = exp(-dist * (10.0 / u_thickness)) * u_glow;\n        float core = exp(-dist * (80.0 / u_thickness)) * 2.5;\n        \n        // Crystalline Refraction: High-frequency shimmering like ice crystals\n        float sparkle = sin(uv.x * 40.0 + uv.y * 10.0 + time * 3.0 + f) * 0.5 + 0.5;\n        sparkle = pow(sparkle, 12.0) * u_metalness;\n        \n        vec3 col = getIceGlacial(i, uv.x + u_hue_offset);\n        \n        // Blend in sparkles and grain for the frozen look\n        vec3 layerColor = col * (bloom + core);\n        layerColor += (sparkle + frost * 0.2) * vec3(0.8, 0.9, 1.0) * core * u_metalness;\n        \n        // Add layers with additive/screen-like blending\n        finalColor += layerColor * 0.35;\n    }\n\n    // Add a cold \"atmospheric mist\" or floor glow\n    finalColor += vec3(0.1, 0.2, 0.3) * exp(-abs(uv0.y + 0.5) * 2.0);\n\n    // Cinematic vignette (colder tones)\n    float vign = smoothstep(1.8, 0.4, length(uv0));\n    finalColor *= vign;\n    \n    // Tonemapping for \"frozen\" contrast\n    finalColor = pow(finalColor, vec3(0.9)); \n    finalColor = smoothstep(-0.05, 1.1, finalColor);\n    \n    // Final touch of blue tint\n    finalColor *= vec3(0.9, 1.0, 1.1);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
