  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; \nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_saturation;\n\n// --- GEOMETRY/DETAIL CONTROLS ---\nuniform float u_tunnel_twist;\nuniform float u_triangle_round;\nuniform float u_sharpness;\nuniform float u_detail_freq;\n\n// --- LUSH CONTROLS ---\nuniform float u_lushness; // Controls color density and secondary layering\nuniform float u_bloom_spread;\n\nout vec4 fragColor;\n\n// --- MATH LIB ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\nfloat sdEquilateralTriangle( vec2 p, float r ) {\n    const float k = sqrt(3.0);\n    p.x = abs(p.x) - r;\n    p.y = p.y + r/k;\n    if( p.x+k*p.y>0.0 ) p = vec2(p.x-k*p.y,-k*p.x-p.y)/2.0;\n    p.x -= clamp( p.x, -2.0*r, 0.0 );\n    return -length(p)*sign(p.y);\n}\n\nfloat hash13(vec3 p3) {\n\tp3  = fract(p3 * .1031);\n    p3 += dot(p3, p3.zyx + 31.32);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec3 rd = normalize(vec3(uv, -1.0 / max(0.1, u_fov))); \n    \n    float t = iTime * ((u_speed <= 0.0) ? 0.2 : u_speed);\n    \n    vec4 col = vec4(0.0);\n    \n    // Increased step count for smoother volume accumulation\n    const int steps = 110; \n    float d = 0.5 + u_camera_dist; \n    \n    for(int i = 0; i < steps; i++) {\n        vec3 p = d * rd;\n        \n        // Move camera\n        p.z += t * 2.0;\n        \n        // Apply twist\n        float angle = p.z * u_tunnel_twist;\n        p.xy *= rot(angle);\n        \n        // Fractal Turbulence\n        float scale = 1.5;\n        vec3 p_orig = p;\n        float noiseDetails = 0.0;\n        for(int j = 0; j < 6; j++) { // One extra iteration for lushness\n            p.xy *= rot(t * 0.01 + float(j) * 0.4 + u_triangle_round);\n            vec3 p_noise = p.yzx * scale - t * 0.5;\n            float s = sin(p_noise.x + cos(p_noise.y + sin(p_noise.z)));\n            p += (u_turbulence_strength * 1.2) * s / scale;\n            noiseDetails += abs(s) / scale;\n            scale *= 1.65;\n        }\n        \n        // Micro-detail texture\n        float microDetail = hash13(p * u_detail_freq) * 0.04;\n        \n        // Main geometry\n        float tri = sdEquilateralTriangle(p.xy, 1.5 * u_cloud_height);\n        \n        // Lush Secondary Geometry: adds \"leaves\" or \"filaments\"\n        float tri2 = sdEquilateralTriangle(p.xy * 1.3, 1.2 * u_cloud_height);\n        float filaments = smoothstep(0.1, 0.0, abs(tri2 + sin(p.z * 2.0) * 0.1)) * u_lushness;\n        \n        // Edge calculation\n        float edgeWidth = 0.08 * (1.1 - u_sharpness);\n        float strands = edgeWidth - abs(tri);\n        \n        // Variable stepping for performance and precision\n        float stepSize = 0.04 + max(0.0, -strands) * 0.12;\n        d += stepSize;\n        \n        // Lush color pallet: Shift towards deep greens and purples as fallback\n        float hue = fract(u_color_shift + p_orig.z * 0.02 + t * 0.04);\n        // Mix hue with a \"nature\" bias based on lushness\n        float lushHue = mix(hue, 0.33, u_lushness * 0.4); \n        vec3 pigment = hsv2rgb(vec3(lushHue, max(0.5, u_saturation), 1.0));\n        \n        // Apply micro-detail and filaments\n        pigment += (microDetail * u_sharpness);\n        pigment = mix(pigment, vec3(0.1, 0.8, 0.4), filaments * 0.5);\n        \n        // Volume mask\n        float mask = smoothstep(-edgeWidth, edgeWidth, strands);\n        // Base ambient color for \"lush\" shadows (dark forest/deep ocean vibe)\n        vec3 ambient = mix(vec3(0.01, 0.0, 0.05), vec3(0.0, 0.04, 0.02), u_lushness);\n        vec3 fireCol = mix(ambient, pigment, mask);\n        \n        // Glow with lush bloom\n        float density = 1.0 + u_density_factor;\n        float falloff = mix(3.0, 12.0, u_sharpness) / u_bloom_spread;\n        float glow = exp(strands * (falloff * density));\n        \n        // Add second layer of glow for lushness\n        glow += filaments * 2.0 * u_lushness;\n        \n        float distFade = 1.0 / (1.0 + d * 0.08);\n        \n        // Accumulate with alpha-like behavior\n        float alpha = clamp(glow * 0.1, 0.0, 1.0);\n        col.rgb += fireCol * glow * (u_glow_intensity * 0.018) * distFade;\n        col.a += alpha * 0.05;\n        \n        if (col.a > 0.99) break;\n    }\n    \n    vec3 finalCol = col.rgb;\n    \n    // Lush Post-Processing: Soften blacks and richen midtones\n    finalCol = 1.0 - exp(-finalCol * 1.8); \n    \n    // Contrast Curve: Adjust for organic richness\n    finalCol = pow(finalCol, vec3(1.1, 0.95, 1.05));\n    \n    // Vignette\n    float vig = 1.0 - dot(uv, uv) * 0.4;\n    finalCol *= vig;\n    \n    // Subtle color grading: Lift shadows slightly for \"foggy\" lush forest look\n    finalCol += vec3(0.005, 0.01, 0.005) * u_lushness;\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
