  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; \nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_saturation;\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    // rd: Ray direction using provided FOV logic\n    vec3 rd = normalize(vec3(uv, -1.0 / max(0.1, u_fov))); \n    \n    float t = iTime * ((u_speed <= 0.0) ? 0.2 : u_speed);\n    \n    // Accumulation\n    vec4 col = vec4(0.0);\n    \n    // REDUCED Start distance: Start closer to ensure the volume fills the frame\n    float d = 0.2 + u_camera_dist; \n    \n    for(int i = 0; i < 80; i++) {\n        vec3 p = d * rd;\n        \n        // Turbulence Loop: Swizzling and Sine waves for \"Mixing Paint\"\n        float scale = 1.2; // Slightly lower scale to cover more area\n        vec3 p_orig = p;\n        for(int j = 0; j < 5; j++) {\n            p.xy *= rot(t * 0.05 + float(j) * 0.3);\n            // Swizzling p.yzx for 3D turbulence\n            p += u_turbulence_strength * sin(p.yzx * scale + p.x * 0.5 - t) / scale;\n            scale *= 1.6;\n        }\n        \n        // --- THICKER SEPARATION LOGIC ---\n        // We use a softer \"slab\" boundary to avoid empty black space\n        float strands = u_cloud_height - abs(p.y * 0.6); \n        \n        // Step size: Smaller steps inside the paint for high-fidelity filaments\n        float stepSize = 0.02 + max(strands, -strands * 0.3) * 0.4;\n        d += stepSize;\n        \n        // --- LUSH COLOR LOGIC ---\n        // Hue mapping that flows across the viewport\n        float hue = fract(u_color_shift + p_orig.x * 0.05 + t * 0.03);\n        vec3 pigment = hsv2rgb(vec3(hue, clamp(u_saturation, 0.5, 1.0), 1.0));\n        \n        // Transition from deep ambers to bright pigment\n        vec3 fireCol = mix(vec3(0.05, 0.0, 0.0), pigment, smoothstep(-0.4, 0.4, strands));\n        \n        // Glow: Increased density spread to fill the frame\n        float glow = exp(strands / (0.3 / max(0.1, abs(u_density_factor))));\n        \n        // Accumulate opacity (col.a) to allow for volumetric saturation\n        float alpha = glow * 0.1;\n        col.rgb += fireCol * glow * (u_glow_intensity * 0.018);\n        col.a += alpha;\n        \n        if (col.a > 0.99) break;\n    }\n    \n    // --- HIGH FIDELITY FINISH ---\n    // ReplacedTanh-like compression with filmic log mapping to preserve orange saturation\n    vec3 finalCol = col.rgb;\n    finalCol = finalCol / (1.0 + finalCol * 0.4); \n    \n    // Final contrast push for \"4K\" look\n    finalCol = pow(finalCol, vec3(1.1, 1.0, 0.95));\n    \n    fragColor = vec4(clamp(finalCol, 0.0, 1.0), 1.0);\n}",
