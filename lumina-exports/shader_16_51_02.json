  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \nuniform sampler2D iChannel1; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; // Reused as tunnel radius\nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_tunnel_twist; \nuniform float u_exit_light_size; \nuniform float u_exit_light_bright; \n\n// --- ETHEREAL CONTROLS ---\nuniform float u_ethereal_bloom;\nuniform float u_red_saturation;\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\n#define PI 3.14159265359\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// --- MAIN RENDER LOOP ---\nvoid main() {\n    // 1. Setup UVs and Ray Direction\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // Create the ray direction for a forward-moving perspective\n    vec3 rd = normalize(vec3(uv, 1.0 / u_fov)); \n    \n    // Animation Time\n    float t = iTime * u_speed;\n    \n    // Raymarching Variables\n    vec4 col = vec4(0.0);\n    float dist = u_camera_dist; \n    float stepSize = 0.0;\n    \n    // --- VOLUMETRIC MARCH ---\n    for(int i = 0; i < 80; i++) {\n        \n        // Current Position along Ray\n        vec3 p = dist * rd;\n        p.z += t; // Forward motion\n        \n        // Apply twist to the tunnel based on depth\n        p.xy *= rot(p.z * u_tunnel_twist + t * 0.1);\n        \n        // --- TURBULENCE LOOP (FBM-ish) ---\n        float scale = 2.5;\n        for(int j = 0; j < 4; j++) {\n            p += u_turbulence_strength * sin(p.yzx * scale + t * 0.2) / scale;\n            scale *= 1.6; \n            if (scale > 40.0) break;\n        }\n        \n        // --- CYLINDRICAL DENSITY CALCULATION ---\n        float radius = u_cloud_height * 2.0;\n        float tunnelDist = length(p.xy) - radius;\n        \n        // Calculate Step Size\n        float stepFactor = max(abs(tunnelDist), 0.02);\n        stepSize = stepFactor * 0.45;\n        \n        // Advance Ray\n        dist += stepSize;\n        \n        // --- COLOR ACCUMULATION: ETHEREAL REDS ---\n        float angle = atan(p.y, p.x);\n        \n        // Shift spectrum towards Ethereal Reds/Crimsons/Magents\n        vec3 redBase     = vec3(0.9, 0.05, 0.1) * u_red_saturation; // Crimson Red\n        vec3 magentaBase = vec3(0.7, 0.1, 0.4) * u_red_saturation;  // Deep Ethereal Purple/Red\n        \n        // Dynamic mixing based on distance and rotation\n        float mixVal = sin(p.z * 0.3 + angle + u_color_shift * PI) * 0.5 + 0.5;\n        vec3 baseColor = mix(redBase, magentaBase, mixVal);\n        \n        // Glow logic based on proximity to the tunnel wall\n        float glow = exp(-abs(tunnelDist) * (8.0 / u_density_factor));\n        \n        // Accumulate intensity with an emphasis on soft falloff\n        float attenuation = 1.0 / (1.0 + dist * 0.15);\n        col.rgb += baseColor * glow * (u_glow_intensity * 0.065) * attenuation;\n        \n        // Optimization: early exit if color is saturated\n        if(col.a > 0.99) break;\n    }\n    \n    // --- THE LIGHT AT THE END OF THE TUNNEL (ETHEREAL RED CORE) ---\n    // Make the exit light a soft rosy/white bloom\n    float distToCenter = length(uv);\n    float exitGlow = pow(max(0.0, 1.0 - distToCenter / u_exit_light_size), 3.0);\n    vec3 exitColor = vec3(1.0, 0.85, 0.9) * exitGlow * u_exit_light_bright;\n    \n    // --- POST PROCESSING ---\n    vec3 finalCol = col.rgb + exitColor;\n    \n    // Add Ethereal Red Bloom / Haze\n    finalCol += (vec3(1.0, 0.2, 0.3) * u_ethereal_bloom * 0.25) / (1.0 + distToCenter * 4.0);\n    \n    // Contrast and Tone Mapping for a cinematic feel\n    // Enhancing the reds through slightly more aggressive contrast\n    finalCol = smoothstep(-0.02, 1.4, finalCol);\n    finalCol = pow(finalCol, vec3(0.85)); // Shift gamma to make shadows deeper and reds punchier\n    \n    // Vignette\n    finalCol *= 1.15 - dot(uv, uv) * 0.8;\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
