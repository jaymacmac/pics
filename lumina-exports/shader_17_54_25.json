  "code": "/**\n * Bioluminescent Dreamscape: Neurological Edition\n * \n * Modified to resemble neural pathways, brain waves, and synaptic firing.\n * Features:\n * - Dendrite-like branching structures\n * - Pulsing \"electric\" signals traveling along nerves\n * - Organic, folded cerebral geometry\n */\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User defined uniforms via JSON\nuniform float u_speed;\nuniform float u_camera_dist;\nuniform float u_fov;\nuniform float u_glow_intensity;\nuniform float u_synapse_activity;\nuniform float u_nerve_thickness;\n\n// Audio Reactivity (Assumed environment variables or for future expansion)\nuniform float u_bass; // If not provided, will default or be calculated\n\nout vec4 fragColor;\n\n// --- UTILS ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat hash(vec3 p) {\n    p = fract(p * 0.1031);\n    p += dot(p, p.yzx + 33.33);\n    return fract((p.x + p.y) * p.z);\n}\n\nfloat noise(vec3 p) {\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(mix(hash(i + vec3(0, 0, 0)), hash(i + vec3(1, 0, 0)), f.x),\n                   mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x), f.y),\n               mix(mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x),\n                   mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x), f.y), f.z);\n}\n\nfloat fbm(vec3 p) {\n    float v = 0.0;\n    float a = 0.5;\n    for (int i = 0; i < 4; i++) {\n        v += a * noise(p);\n        p *= 2.0;\n        a *= 0.5;\n    }\n    return v;\n}\n\n// --- WORLD PATH ---\nvec2 getPath(float z) {\n    return vec2(sin(z * 0.2), cos(z * 0.15)) * 2.5;\n}\n\n// --- SDFs ---\nfloat sdCapsule(vec3 p, vec3 a, vec3 b, float r) {\n    vec3 pa = p - a, ba = b - a;\n    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);\n    return length(pa - ba * h) - r;\n}\n\n// Global variable to store electrical signal intensity for coloring\nfloat g_signal = 0.0;\n\nfloat map(vec3 p) {\n    vec2 path = getPath(p.z);\n    p.xy -= path;\n    \n    // Create \"Cerebral fold\" noise\n    float folds = fbm(p * 0.5 + iTime * 0.1) * 0.5;\n    \n    // Neural Dendrites (main structure)\n    vec3 p_dendrite = p;\n    float z_idx = floor(p.z * 0.5);\n    p_dendrite.z = mod(p_dendrite.z, 2.0) - 1.0;\n    p_dendrite.xy *= rot(p.z * 0.5 + iTime * 0.1);\n    \n    // Create multiple branching \"fibers\"\n    float d = 1e10;\n    for(int i = 0; i < 3; i++) {\n        float fi = float(i);\n        vec3 p_f = p_dendrite;\n        p_f.xy += vec2(sin(p.z * 0.8 + fi), cos(p.z * 1.2 + fi)) * 0.6;\n        float fiber = length(p_f.xy) - u_nerve_thickness;\n        d = min(d, fiber);\n    }\n    \n    // Synaptic \"signals\" traveling along the Z axis\n    float signalPos = mod(p.z * 0.5 - iTime * 2.0 * u_synapse_activity, 4.0);\n    float signalWidth = 0.4;\n    float signal = smoothstep(signalWidth, 0.0, abs(signalPos - 2.0));\n    g_signal = max(g_signal, signal); // Store for glow calc\n    \n    // Displacement for organic texture\n    float disp = noise(p * 4.0) * 0.15;\n    \n    // Background brain-matter clouds\n    float brainMatter = 4.0 - length(p.xy) + folds;\n    \n    return min(d + disp, brainMatter);\n}\n\n// --- RAYMARCHING ---\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    float time = iTime * u_speed;\n    \n    // 1. PATH POSITIONING\n    vec3 pathPos = vec3(0.0, 0.0, time);\n    pathPos.xy += getPath(pathPos.z);\n    \n    // 2. PARALLEL RAIL CAMERA\n    float railRadius = u_camera_dist;\n    vec2 railAngle = vec2(cos(time * 0.1), sin(time * 0.1)) * railRadius;\n    \n    vec3 ro = pathPos;\n    ro.xy += railAngle;\n    \n    vec3 ta = vec3(0.0, 0.0, time + 8.0);\n    ta.xy += getPath(ta.z) + railAngle * 0.5;\n    \n    // Camera Transform\n    vec3 cw = normalize(ta - ro);\n    vec3 cp = vec3(0.0, 1.0, 0.0);\n    vec3 cu = normalize(cross(cw, cp));\n    vec3 cv = normalize(cross(cu, cw));\n    vec3 rd = normalize(uv.x * cu + uv.y * cv + u_fov * cw);\n    \n    // 3. MARCHING\n    float t = 0.0;\n    float glow = 0.0;\n    float signalAcc = 0.0;\n    \n    for(int i = 0; i < 90; i++) {\n        vec3 p = ro + rd * t;\n        g_signal = 0.0; // Reset for this step\n        float d = map(p);\n        \n        // Accumulate glow based on SDF proximity and the \"signal\" pulse\n        float localGlow = exp(-d * 3.5);\n        glow += localGlow * u_glow_intensity;\n        signalAcc += localGlow * g_signal * u_synapse_activity;\n        \n        if(d < 0.005 || t > 35.0) break;\n        t += d * 0.5;\n    }\n    \n    // 4. COLORING\n    // Deep dark cerebral blue/magenta base\n    vec3 bgCol = mix(vec3(0.02, 0.01, 0.05), vec3(0.05, 0.02, 0.1), fbm(vec3(uv * 2.0, time * 0.1)));\n    \n    // Neural glow: Pinkish-Purple (dendrites) and Electric Blue (signals)\n    vec3 nerveCol = vec3(0.8, 0.2, 0.6); // Nerve body\n    vec3 signalCol = vec3(0.2, 0.7, 1.0); // Electric impulse\n    \n    vec3 col = bgCol;\n    col += nerveCol * (glow * 0.1);\n    col += signalCol * (signalAcc * 0.6); // Add electric impulses\n    \n    // Volumetric fog (CSF fluid)\n    col = mix(col, vec3(0.05, 0.01, 0.08), 1.0 - exp(-0.06 * t));\n    \n    // Screen-space brain wave pulse effect\n    float brainWave = sin(uv.y * 20.0 - iTime * 10.0) * 0.01;\n    col += signalCol * brainWave * u_synapse_activity;\n    \n    // Subtle film grain/synaptic noise\n    col += (hash(vec3(uv, iTime)) - 0.5) * 0.03;\n    \n    // Tone mapping and Gamma\n    col = smoothstep(-0.1, 1.2, col);\n    col = pow(col, vec3(0.4545));\n\n    fragColor = vec4(col, 1.0);\n}",
