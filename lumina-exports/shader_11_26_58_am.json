  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Parameter mappings\nuniform float u_speed;\nuniform float u_fov;\nuniform float u_camera_dist;\nuniform float u_glow_intensity;\nuniform float u_tunnel_twist;\nuniform float u_triangle_size;\n\nout vec4 fragColor;\n\n// 2D Rotation Matrix\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Signed Distance Function for an equilateral triangle prism\nfloat sdTrianglePrism(vec2 p, float r) {\n    const float k = sqrt(3.0);\n    p.x = abs(p.x) - r;\n    p.y = p.y + r / k;\n    if (p.x + k * p.y > 0.0) p = vec2(p.x - k * p.y, -k * p.x - p.y) / 2.0;\n    p.x -= clamp(p.x, -2.0 * r, 0.0);\n    return -length(p) * sign(p.y);\n}\n\n// Smooth Minimum for blending shapes\nfloat smin(float a, float b, float k) {\n    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n    return mix(b, a, h) - k * h * (1.0 - h);\n}\n\n// Universe Path - The world curves slightly to create an infinite feeling\nvec2 getPath(float z) {\n    return vec2(sin(z * 0.12) * 3.5, cos(z * 0.08) * 2.5);\n}\n\n// Distance Field\nfloat map(vec3 p) {\n    // Offset the entire world by the path\n    vec2 path = getPath(p.z);\n    p.xy -= path;\n    \n    // Twist the coordinate system along the Z axis\n    float angle = p.z * u_tunnel_twist + iTime * 0.2;\n    p.xy *= rot(angle);\n    \n    // Create the Triangle Tunnel\n    // Negative because we are inside the prism\n    float triangle = -sdTrianglePrism(p.xy, u_triangle_size);\n    \n    // Add internal floating triangle rings\n    vec3 p_rings = p;\n    float ringZ = 6.0;\n    float ringId = floor(p_rings.z / ringZ);\n    p_rings.z = mod(p_rings.z, ringZ) - ringZ * 0.5;\n    \n    // Alternate rotation for rings\n    p_rings.xy *= rot(ringId * 1.5 + iTime);\n    float rings = max(abs(sdTrianglePrism(p_rings.xy, u_triangle_size * 0.7)) - 0.1, abs(p_rings.z) - 0.2);\n    \n    // Floating orbs that follow the path center\n    vec3 p_spheres = p;\n    p_spheres.z = mod(p_spheres.z + 4.0, 8.0) - 4.0;\n    p_spheres.y += sin(iTime + p.z * 0.5) * 1.0;\n    float spheres = length(p_spheres) - 0.4;\n    \n    // Combine everything\n    float scene = min(triangle, rings);\n    scene = smin(scene, spheres, 0.8);\n    \n    return scene;\n}\n\n// Standard normal calculation\nvec3 getNormal(vec3 p) {\n    vec2 e = vec2(0.01, 0);\n    return normalize(vec3(\n        map(p + e.xyy) - map(p - e.xyy),\n        map(p + e.yxy) - map(p - e.yxy),\n        map(p + e.yyx) - map(p - e.yyx)\n    ));\n}\n\nvoid main() {\n    // 1. Correct Aspect Ratio UVs\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // 2. Fly-through timing\n    float t = iTime * u_speed;\n    \n    // 3. Parallel Rail Camera Setup\n    vec3 pathPos = vec3(0.0, 0.0, t);\n    pathPos.xy += getPath(pathPos.z);\n    \n    // The Rail: Camera orbits the path center\n    vec2 railVec = vec2(sin(t * 0.2), cos(t * 0.2)) * (u_camera_dist * 0.5);\n    \n    vec3 ro = pathPos;\n    ro.xy += railVec;\n    \n    // Target: Look ahead\n    vec3 ta = vec3(0.0, 0.0, t + 10.0);\n    ta.xy += getPath(ta.z); \n    \n    // Camera Basis\n    vec3 fwd = normalize(ta - ro);\n    vec3 right = normalize(cross(vec3(0, 1, 0), fwd));\n    vec3 up = cross(fwd, right);\n    vec3 rd = normalize(fwd * u_fov + uv.x * right + uv.y * up);\n    \n    // 4. Raymarching Loop\n    float d = 0.0;\n    float t_dist = 0.1;\n    float glow = 0.0;\n    \n    for(int i = 0; i < 90; i++) {\n        vec3 p = ro + rd * t_dist;\n        d = map(p);\n        \n        // Accumulate glow based on proximity to the geometric edges\n        glow += exp(-max(d, 0.0) * 1.2) * u_glow_intensity;\n        \n        if(abs(d) < 0.001 || t_dist > 80.0) break;\n        t_dist += d * 0.7; \n    }\n    \n    // 5. Coloring and Shading\n    vec3 col = vec3(0.0);\n    vec3 p = ro + rd * t_dist;\n    \n    // Base Gradient Colors\n    vec3 skyTop = vec3(0.05, 0.02, 0.1);\n    vec3 skyBottom = vec3(0.2, 0.05, 0.4);\n    vec3 neonColor = vec3(0.2, 0.8, 1.0);\n    \n    if(t_dist < 80.0) {\n        vec3 n = getNormal(p);\n        float diff = max(dot(n, normalize(vec3(1, 2, -1))), 0.0);\n        float fresnel = pow(1.0 - max(dot(n, -rd), 0.0), 3.0);\n        \n        // Procedural color based on rotation/twist\n        float hue = sin(p.z * 0.05 + iTime * 0.2) * 0.5 + 0.5;\n        vec3 objCol = mix(vec3(0.1, 0.05, 0.2), vec3(0.4, 0.1, 0.6), hue);\n        \n        // Add metallic/neon edges\n        objCol = mix(objCol, neonColor, fresnel * 0.8);\n        \n        col = objCol * (diff + 0.1);\n        \n        // Specular highlights\n        col += vec3(1.0, 0.9, 0.8) * pow(max(dot(reflect(rd, n), normalize(vec3(0,1,0))), 0.0), 16.0);\n    } else {\n        // Background Gradient\n        col = mix(skyBottom, skyTop, uv.y + 0.5);\n    }\n    \n    // 6. Volumetric Fog & Glowing Atmosphere\n    float fog = 1.0 - exp(-t_dist * 0.03);\n    vec3 fogCol = mix(vec3(0.01, 0.0, 0.05), vec3(0.2, 0.05, 0.3), sin(t * 0.05) * 0.5 + 0.5);\n    col = mix(col, fogCol, fog);\n    \n    // Apply the neon glow\n    col += mix(vec3(1.0, 0.2, 0.5), neonColor, sin(t * 0.5) * 0.5 + 0.5) * glow * 0.05;\n    \n    // 7. Post-Processing\n    col = smoothstep(-0.02, 1.05, col); // Soft contrast\n    col *= 1.2 - length(uv) * 0.6;      // Stronger Vignette\n    \n    // Noise/Grain\n    float grain = texture(iChannel0, uv * 3.0 + t * 0.05).r;\n    col += (grain - 0.5) * 0.04;\n\n    fragColor = vec4(col, 1.0);\n}",
