  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_glow;\nuniform float u_hue;   // Outer Color\nuniform float u_hue2;  // Inner Color\nuniform float u_twist;\nuniform float u_perspective;\nuniform float u_auto_wobble; // Control to toggle the 4-minute cycle\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\n// HSB to RGB Conversion\nvec3 hsb2rgb(vec3 c) {\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\n// Dual-Hue Palette Logic\nvec3 getLayerColor(float t, float hue1, float hue2) {\n    float h = mix(hue1, hue2, t);\n    float sat = mix(0.9, 0.5, t);\n    float bri = mix(0.5, 1.0, t);\n    return hsb2rgb(vec3(h, sat, bri));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // Convert UV to Polar for Tunnel effect\n    float angle = atan(uv.y, uv.x) / (2.0 * 3.14159); // -0.5 to 0.5\n    float dist = length(uv);\n    \n    // Safety Fallbacks for Params\n    float spd = (u_speed <= 0.0) ? 0.3 : u_speed;\n    float time = iTime * spd;\n    \n    // --- 4 Minute Oscillation Logic ---\n    // Cycle length: 4 minutes = 240 seconds. \n    // To go 0 -> 5 -> 0, we use a sine wave with a period of 480 seconds (8 minutes total for full loop)\n    // but we can use abs(sin) or a remapped cos for a 4 minute round trip.\n    float cyclePeriod = 240.0; // 4 minutes\n    float cyclePhase = iTime * (3.14159265 / cyclePeriod);\n    // This creates a smooth curve oscillating between 0 and 5 every 4 minutes.\n    float autoScale = (0.5 - 0.5 * cos(cyclePhase)) * 5.0;\n    \n    // Mix manual scale with auto scale based on toggle\n    float scale = mix(u_scale, autoScale, u_auto_wobble);\n    \n    float glowInt = u_glow;\n    float twist = u_twist;\n    float perspective = max(0.1, u_perspective);\n    \n    float hue1 = u_hue; \n    float hue2 = u_hue2;\n\n    // Background: Deep dark blend\n    vec3 bgCol = hsb2rgb(vec3(mix(hue1, hue2, 0.5), 0.9, 0.02));\n    vec3 finalColor = bgCol;\n\n    // Number of rings in the tunnel\n    const int LAYER_COUNT = 12;\n\n    // Loop for layers: each layer represents a depth step in the tunnel\n    for(int i = 0; i < LAYER_COUNT; i++) {\n        float layerIndex = float(i);\n        \n        // SEAMLESS DEPTH LOGIC:\n        // By adding (i/COUNT) inside the fract, each ring has a different phase.\n        float depth = fract(layerIndex / float(LAYER_COUNT) + time * 0.2); \n        \n        // Depth mapping: inner rings are smaller/further away\n        float radius = depth * perspective; \n        \n        // Fade layers in at the center and out at the edges to hide the \"reset\"\n        float fade = smoothstep(0.0, 0.2, depth) * smoothstep(1.0, 0.7, depth);\n        \n        // Tunnel Wall coordinate mapping\n        float wallAngle = angle + depth * twist;\n        \n        // --- Wave Logic (Applied to the ring radius) ---\n        float wave = sin(wallAngle * 6.28 * 3.0 + time * 2.0 + layerIndex) * 0.05;\n        wave += sin(wallAngle * 6.28 * 7.0 - time) * 0.02;\n        \n        // Apply the oscillating scale here\n        wave *= scale;\n        \n        float ringRadius = radius + wave;\n\n        // Mask: Are we inside the current ring?\n        float fillMask = smoothstep(0.03, -0.03, dist - ringRadius);\n        \n        // Edge Glow\n        float edgeDist = abs(dist - ringRadius);\n        float edgeGlow = exp(-edgeDist * 20.0) * glowInt;\n\n        // --- Color Logic ---\n        vec3 col = getLayerColor(depth, hue1, hue2);\n        \n        // --- Composition ---\n        finalColor += col * fillMask * 0.15 * fade; \n        finalColor += col * edgeGlow * 0.5 * fade; \n    }\n\n    // Vignette / Center darkness for depth focus\n    finalColor *= smoothstep(0.0, 0.5, dist);\n    finalColor *= 1.4 - length(uv0) * 0.7;\n    \n    // Tonemapping/Contrast\n    finalColor = pow(finalColor, vec3(0.9));\n    finalColor = smoothstep(-0.02, 1.05, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
