  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\nuniform float u_speed;\nuniform float u_camera_dist;\nuniform float u_fov;\nuniform float u_twist;\nuniform float u_thickness;\nuniform float u_glow_intensity;\nuniform float u_wave_height;\nuniform float u_wave_freq;\nuniform float u_darkness;\nuniform float u_color_saturation;\n\nout vec4 fragColor;\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat smin(float a, float b, float k) {\n    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n    return mix(b, a, h) - k * h * (1.0 - h);\n}\n\n// Higher quality hash for dithering\nfloat noise(vec2 p) {\n    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nfloat getCarpetWave(vec2 p) {\n    float t = iTime * u_speed;\n    float wave = sin(p.x * u_wave_freq + t) * cos(p.y * u_wave_freq * 0.8 + t * 0.5);\n    wave += 0.5 * sin(p.x * u_wave_freq * 2.1 - t * 1.2);\n    wave *= u_wave_height;\n    return wave;\n}\n\nfloat map(vec3 p) {\n    float t = iTime * u_speed * 0.5;\n    float waveHeight = getCarpetWave(p.xz);\n    float floorDist = p.y - waveHeight;\n    float strands = 1e10;\n    \n    for(float i = 0.0; i < 3.0; i += 1.0) {\n        float offset = i * 2.0;\n        vec2 pathPoint = vec2(p.x, sin(p.x * 0.2 + t + offset) * 5.0);\n        float pathWave = getCarpetWave(vec2(p.x, pathPoint.y));\n        vec3 strandPos = vec3(p.x, pathWave + 0.5, pathPoint.y);\n        vec3 q = p - strandPos;\n        q.xz *= rot(p.x * u_twist + t);\n        float ribbon = length(q.yz) - u_thickness * (0.5 + 0.3 * sin(p.x * 2.0 + t));\n        strands = smin(strands, ribbon, 1.2);\n    }\n    return smin(floorDist, strands, 0.8);\n}\n\nvec3 getNormal(vec3 p) {\n    vec2 e = vec2(0.005, 0.0); // Tighter epsilon for 4K\n    return normalize(vec3(\n        map(p + e.xyy) - map(p - e.xyy),\n        map(p + e.yxy) - map(p - e.yxy),\n        map(p + e.yyx) - map(p - e.yyx)\n    ));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    float globalTime = iTime * u_speed;\n    \n    vec3 ro = vec3(globalTime * 2.0, u_camera_dist, 0.0);\n    float lookAheadX = ro.x + 5.0;\n    float lookAtY = getCarpetWave(vec2(lookAheadX, 0.0)) * 0.5;\n    vec3 ta = vec3(lookAheadX, lookAtY, 0.0);\n    \n    vec3 cw = normalize(ta - ro);\n    vec3 cu = normalize(cross(cw, vec3(0, 1, 0)));\n    vec3 cv = normalize(cross(cu, cw));\n    vec3 rd = normalize(uv.x * cu + uv.y * cv + u_fov * cw);\n\n    float t = 0.0, d = 0.0, glow = 0.0;\n    vec3 col = vec3(0.0);\n    \n    // Increased steps to 128 for 4K precision\n    for(int i = 0; i < 128; i++) {\n        vec3 p = ro + rd * t;\n        d = map(p);\n        glow += (0.01 / (0.04 + d * d)) * (1.0 - u_darkness * 0.5);\n        if(d < 0.001 || t > 60.0) break;\n        t += d * 0.6; \n    }\n\n    if(t < 60.0) {\n        vec3 p = ro + rd * t;\n        vec3 n = getNormal(p);\n        vec3 ref = reflect(rd, n);\n        float ao = clamp(0.5 + 0.5 * n.y, 0.0, 1.0);\n        float fres = pow(1.0 + dot(rd, n), 5.0);\n        \n        vec3 palette = 0.5 + 0.5 * cos(vec3(0.0, 0.1, 0.2) + p.x * 0.05);\n        vec3 baseCol = mix(vec3(0.02), palette, u_color_saturation);\n        \n        vec3 lp = ro + vec3(-5.0, 15.0, -5.0);\n        vec3 ld = normalize(lp - p);\n        float diff = pow(max(dot(n, ld), 0.0), 1.0 + u_darkness * 2.0);\n        float spec = pow(max(dot(ref, ld), 0.0), 50.0);\n        \n        col = baseCol * diff + (spec * 0.5) + (fres * baseCol * 0.3);\n        col *= ao;\n        vec3 tex = texture(iChannel0, p.xz * 0.1).rgb;\n        col *= mix(vec3(1.0), tex, 0.4);\n    }\n    \n    vec3 glowCol = 0.5 + 0.5 * cos(vec3(0.8, 0.9, 1.0) + globalTime * 0.2);\n    col += glow * glowCol * u_glow_intensity;\n    \n    vec3 fogColor = vec3(0.002, 0.002, 0.005);\n    col = mix(col, fogColor, smoothstep(20.0, 60.0, t));\n\n    // --- BANDING FIX: DITHERING ---\n    // Adds a tiny bit of noise to the 8-bit signal to smooth gradients\n    float dither = noise(gl_FragCoord.xy + iTime) / 255.0;\n    col += dither;\n\n    col = pow(col, vec3(0.85)); // Deepen blacks\n    col = clamp(col, 0.0, 1.0);\n\n    fragColor = vec4(col, 1.0);\n}",
