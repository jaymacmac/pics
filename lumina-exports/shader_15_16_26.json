  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_glow;\nuniform float u_block_size; \nuniform float u_hue_shift;   // New Parameter\nuniform float u_saturation;  // New Parameter\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// Helper to handle hue shifting\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\nvec3 rgb2hsv(vec3 c) {\n    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);\n    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));\n    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));\n\n    float d = q.x - min(q.w, q.y);\n    float e = 1.0e-10;\n    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n}\n\n// Explicit \"5 Shades\" Palette with Hue Control\nvec3 getLayerColor(int i) {\n    vec3 baseCol;\n    if (i == 0) baseCol = vec3(0.55, 0.15, 0.05); // Deepest Burnt Orange\n    else if (i == 1) baseCol = vec3(0.80, 0.30, 0.05); // Rusty Orange\n    else if (i == 2) baseCol = vec3(1.00, 0.50, 0.10); // True Orange\n    else if (i == 3) baseCol = vec3(1.00, 0.70, 0.20); // Amber Gold\n    else baseCol = vec3(1.00, 0.85, 0.50);             // Pale Peach\n    \n    // Convert to HSV to apply the two hue/color options (Shift and Saturation)\n    vec3 hsv = rgb2hsv(baseCol);\n    hsv.x = fract(hsv.x + u_hue_shift);\n    hsv.y *= u_saturation;\n    \n    return hsv2rgb(hsv);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // Params\n    float spd = (u_speed <= 0.0) ? 0.3 : u_speed;\n    float time = iTime * spd;\n    float scale = (u_scale <= 0.0) ? 1.0 : u_scale;\n    float glowInt = (u_glow <= 0.0) ? 1.5 : u_glow;\n    float blockSize = (u_block_size <= 0.0) ? 10.0 : u_block_size;\n\n    // Pixelate the UV coordinates to create a \"Square\" or \"Voxel\" look\n    vec2 gridUV = floor(uv * blockSize) / blockSize;\n\n    // Background: Dark version of the primary shifted color\n    vec3 bgBase = getLayerColor(0);\n    vec3 finalColor = bgBase * 0.1;\n\n    // Loop exactly 5 times for 5 distinct waves\n    for(int i = 0; i < 5; i++) {\n        \n        // --- Wave Shape ---\n        float layerIndex = float(i);\n        \n        // Calculate wave height based on pixelated gridUV\n        float waveHeight = sin(gridUV.x * 2.0 + time + layerIndex) * 0.3; \n        waveHeight += sin(gridUV.x * 5.0 - time * 1.5) * 0.1; \n        waveHeight *= scale;\n        \n        // Offset Y position: Layer 0 is at bottom, Layer 4 is higher up\n        float yOffset = -0.6 + (layerIndex * 0.25); \n        float surfaceY = waveHeight + yOffset;\n\n        // Use pixelated Y for the fill calculation to keep it \"blocky\"\n        float fillMask = step(gridUV.y, surfaceY);\n        \n        // Edge Glow: We still use the pixelated surface height\n        float edgeDist = abs(uv.y - surfaceY);\n        float edgeGlow = exp(-edgeDist * (blockSize * 0.8)) * glowInt;\n\n        // --- Color ---\n        vec3 col = getLayerColor(i);\n        \n        // --- Composition ---\n        \n        // Add the Fill (Blocky)\n        finalColor += col * fillMask * 0.2; \n        \n        // Add the Edge Bloom\n        finalColor += col * edgeGlow * 0.6;\n    }\n\n    // Vignette\n    finalColor *= 1.2 - length(uv0) * 0.5;\n    \n    // Grid Lines for extra \"square\" aesthetic\n    vec2 lines = fract(uv * blockSize);\n    float grid = smoothstep(0.0, 0.05, lines.x) * smoothstep(1.0, 0.95, lines.x) *\n                 smoothstep(0.0, 0.05, lines.y) * smoothstep(1.0, 0.95, lines.y);\n    finalColor *= (0.8 + 0.2 * grid);\n\n    // Clamp\n    finalColor = smoothstep(-0.02, 1.2, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
