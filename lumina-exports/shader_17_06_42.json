  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist;\nuniform float u_orbit_radius; \nuniform float u_fov;\nuniform float u_twist;\nuniform float u_thickness;\nuniform float u_glow_intensity;\nuniform float u_wave_height;\nuniform float u_wave_freq;\nuniform float u_darkness;\nuniform float u_color_saturation;\nuniform float u_viscosity;\nuniform float u_hue_shift; \n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Polynomial Smooth Minimum for organic liquid blending\nfloat smin(float a, float b, float k) {\n    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n    return mix(b, a, h) - k * h * (1.0 - h);\n}\n\n// Water Palette: Cyan, Deep Blue, and Emerald\nvec3 getWaterPalette(float t) {\n    vec3 a = vec3(0.5, 0.5, 0.5);\n    vec3 b = vec3(0.5, 0.5, 0.5);\n    vec3 c = vec3(1.0, 1.0, 1.0);\n    vec3 d = vec3(0.5, 0.6, 0.7); // Shifted toward aquatic tones\n    return a + b * cos(6.28318 * (c * t + d));\n}\n\n// Liquid Wave Logic\nfloat getWaterHeight(vec2 p) {\n    float t = iTime * u_speed;\n    float wave = sin(p.x * u_wave_freq + t) * cos(p.y * (u_wave_freq * 0.5) + t * 0.3);\n    wave += (0.5 - u_viscosity * 0.1) * sin(p.y * u_wave_freq * 2.1 - t * 1.2);\n    return wave * u_wave_height;\n}\n\n// Distance Field for Water Surface\nfloat map(vec3 p) {\n    float h = getWaterHeight(p.xz);\n    // Defines the distance to the \"top\" of the water plane\n    return p.y - h;\n}\n\nvec3 getNormal(vec3 p) {\n    vec2 e = vec2(0.01, 0.0);\n    return normalize(vec3(\n        map(p + e.xyy) - map(p - e.xyy),\n        map(p + e.yxy) - map(p - e.yxy),\n        map(p + e.yyx) - map(p - e.yyx)\n    ));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    float globalTime = iTime * u_speed;\n    \n    // Camera Setup (Orbiting above the water)\n    float angle = globalTime * 0.2;\n    vec3 ro = vec3(cos(angle) * u_orbit_radius, u_camera_dist, sin(angle) * u_orbit_radius);\n    vec3 ta = vec3(0.0, 0.0, 0.0);\n    \n    vec3 cw = normalize(ta - ro);\n    vec3 cu = normalize(cross(cw, vec3(0, 1, 0)));\n    vec3 cv = normalize(cross(cu, cw));\n    vec3 rd = normalize(uv.x * cu + uv.y * cv + max(0.1, u_fov) * cw);\n\n    // --- TRANSPARENT MARCHING ---\n    vec4 col = vec4(0.0);\n    float t = 0.0;\n    \n    // Base Colors based on Hue Shift\n    vec3 waterBase = getWaterPalette(u_hue_shift);\n    vec3 deepWater = waterBase * 0.1;\n    \n    for(int i = 0; i < 64; i++) {\n        vec3 p = ro + rd * t;\n        float d = map(p);\n        \n        // If we are \"inside\" the water (d < 0)\n        if (d < 0.0) {\n            // Accumulate color based on depth (Beer's Law simulation)\n            float depth = abs(d);\n            vec3 layerCol = mix(waterBase, deepWater, smoothstep(0.0, u_thickness * 2.0, depth));\n            \n            // Transparency accumulation\n            float alpha = (1.0 - col.a) * 0.1 * u_color_saturation;\n            col.rgb += layerCol * alpha;\n            col.a += alpha;\n        }\n        \n        // If we hit the surface from above, add reflections\n        if (i == 0 || (d < 0.01 && col.a < 0.1)) {\n           vec3 n = getNormal(p);\n           float fresnel = pow(1.0 + dot(rd, n), 5.0);\n           col.rgb += waterBase * fresnel * 0.3 * u_glow_intensity;\n        }\n\n        t += max(0.02, abs(d) * 0.5); // Constant steps for volumetric feel\n        if(t > 30.0 || col.a > 0.95) break;\n    }\n\n    // --- SURFACE SPECULAR (Sun Glint) ---\n    // Finding the surface intersection for a sharp highlight\n    float surfT = 0.0;\n    for(int i=0; i<30; i++) {\n        float d = map(ro + rd * surfT);\n        if(d < 0.01) break;\n        surfT += d;\n    }\n    \n    if(surfT < 30.0) {\n        vec3 p = ro + rd * surfT;\n        vec3 n = getNormal(p);\n        vec3 lightDir = normalize(vec3(5.0, 10.0, -2.0));\n        vec3 ref = reflect(rd, n);\n        float spec = pow(max(dot(ref, lightDir), 0.0), 64.0);\n        col.rgb += vec3(1.0, 0.9, 0.8) * spec * 0.5; // Sun glint\n    }\n\n    // Final Post-Proc\n    vec3 finalCol = col.rgb;\n    finalCol = mix(finalCol, deepWater, smoothstep(5.0, 30.0, t) * u_darkness);\n    \n    // Add fake \"caustics\" glow\n    finalCol += u_glow_intensity * 0.05 * waterBase;\n\n    fragColor = vec4(clamp(pow(finalCol, vec3(0.8)), 0.0, 1.0), 1.0);\n}",
