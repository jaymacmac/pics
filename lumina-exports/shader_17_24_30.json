  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\n\n// User Parameters (Preserved)\nuniform float u_speed;        \nuniform float u_thickness;    \nuniform float u_glow;         \nuniform float u_hue_offset;   \nuniform float u_metalness;    \nuniform float u_gold_mix;     \nuniform float u_frost_amount; \n\n// New Parameters for Neurology Look\nuniform float u_complexity;   // Number of neural strands\nuniform float u_pulse_speed;  // Speed of the electric pulses\n\nout vec4 fragColor;\n\n// A smoother rotation helper\nmat2 rot(float a) { return mat2(cos(a), -sin(a), sin(a), cos(a)); }\n\n// Simple pseudo-random hash for frost texture and strand randomness\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// Neural/Ice Palette\nvec3 getNeuralColor(float f, float xPos) {\n    // Electric Blue/Cyan for synapses\n    vec3 iceSurface = vec3(0.4, 0.8, 1.0);\n    // Deeper violet/navy for neural pathways\n    vec3 iceDeep = vec3(0.1, 0.2, 0.5);\n    \n    float mixer = clamp(sin(xPos * 0.5 + f * 0.7) * 0.5 + 0.5, 0.0, 1.0);\n    mixer = mix(mixer, 1.0, u_gold_mix); \n    \n    return mix(iceSurface, iceDeep, mixer);\n}\n\nvoid main() {\n    // Corrected UVs to maintain aspect ratio\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / min(iResolution.y, iResolution.x);\n    vec2 uv0 = uv;\n\n    float time = iTime * u_speed;\n    \n    // Deep dark brain-space background\n    vec3 finalColor = vec3(0.005, 0.01, 0.02); \n\n    // Fine crystalline grain for neural background texture\n    float frost = hash(uv * 800.0) * u_frost_amount;\n\n    // Increased iterations for \"Neurology Strands\"\n    int strands = int(u_complexity);\n    for(int i = 0; i < strands; i++) {\n        float f = float(i);\n        \n        // Randomize strand paths based on index\n        float h = hash(vec2(f, f * 0.1));\n        \n        // --- NEURAL STRAND LOGIC (Thin, erratic, interconnected) ---\n        // Combination of multiple frequencies to simulate dendrites/axons\n        float wave = sin(uv.x * (1.2 + h) + time + f) * (0.15 + h * 0.1);\n        wave += cos(uv.x * (3.5 * h) - time * 1.2) * 0.08;\n        wave += sin(uv.x * 8.0 + f) * 0.02; // Fine detail jitter\n        \n        // Vertical positioning\n        float yOffset = -0.8 + (1.6 * (f / float(strands))) + sin(time * 0.2 + f) * 0.05;\n        \n        // Distance to the neural line (thinner focus)\n        float dist = abs(uv.y - (wave + yOffset));\n\n        // --- SYNAPSE RENDERING ---\n        // Electric pulses traveling along the strands\n        float pulsePos = uv.x * 2.0 - (iTime * u_pulse_speed) + h * 10.0;\n        float pulse = pow(max(0.0, sin(pulsePos)), 20.0);\n        \n        // Tightening the thickness for \"thin lines\"\n        float thicknessScale = u_thickness * 0.2; // Scaling down for neurology look\n        float core = exp(-dist * (150.0 / thicknessScale)) * 2.0;\n        float glow = exp(-dist * (40.0 / thicknessScale)) * u_glow;\n        \n        // Combine base color with the electric pulse\n        vec3 col = getNeuralColor(f, uv.x + u_hue_offset);\n        \n        // High frequency sparkle acts as \"synaptic firing\"\n        float sparkle = sin(uv.x * 60.0 + time * 5.0 + f) * 0.5 + 0.5;\n        sparkle = pow(sparkle, 20.0) * u_metalness;\n        \n        // Layer compositing\n        vec3 strandColor = col * (core * 1.5 + glow * 0.4);\n        // Add the electric pulse highlight\n        strandColor += vec3(0.8, 0.9, 1.0) * pulse * core * 3.0;\n        // Add crystalline frost grain for \"frozen neural\" look\n        strandColor += (sparkle + frost * 0.5) * vec3(0.7, 0.85, 1.0) * core;\n        \n        // Additive blend with a scaling factor based on count\n        finalColor += strandColor * (2.0 / float(strands));\n    }\n\n    // Add a central neural hub glow\n    float hubGlow = exp(-length(uv0) * 1.5) * 0.15;\n    finalColor += vec3(0.1, 0.25, 0.4) * hubGlow;\n\n    // Cinematic vignette\n    float vign = smoothstep(1.5, 0.2, length(uv0));\n    finalColor *= vign;\n    \n    // Tonemapping for electric contrast\n    finalColor = pow(finalColor, vec3(0.85)); \n    finalColor = smoothstep(-0.02, 1.05, finalColor);\n    \n    // Final spectral shift\n    finalColor *= vec3(0.95, 1.0, 1.05);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
