  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Audio Reactivity\nuniform float u_bass;\nuniform float u_mid;\nuniform float u_treble;\nuniform float u_vol;\n\n// Mandatory Parameters\nuniform float u_speed;\nuniform float u_complexity;\nuniform float u_glow_intensity;\nuniform float u_color_shift;\nuniform float u_alpha_fade;\nuniform float u_brightness_fix;\nuniform float u_zoom;\nuniform float u_sharpness;\nuniform float u_saturation;\nuniform float u_contrast;\n\n// Depth Magic Parameters\nuniform float u_parallax;\nuniform float u_fog_density;\n\nout vec4 fragColor;\n\n// 2D Rotation Matrix\nmat2 rot(float a) {\n    float s = sin(a);\n    float c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Color processing helpers\nvec3 saturate(vec3 rgb, float adjustment) {\n    const vec3 W = vec3(0.2125, 0.7154, 0.0721);\n    vec3 intensity = vec3(dot(rgb, W));\n    return mix(intensity, rgb, adjustment);\n}\n\nvec3 contrast(vec3 rgb, float adjustment) {\n    return (rgb - 0.5) * adjustment + 0.5;\n}\n\n// Organic wave with integrated depth-based parallax\nfloat organicWave(vec2 uv, float depth, float offset) {\n    // Parallax movement based on depth\n    float t = iTime * u_speed * 0.3 + offset;\n    vec2 p = uv * (1.0 + depth * 0.1);\n    \n    // Shift p based on depth to create \"Depth Magic\" parallax\n    p += (iMouse.xy / iResolution.xy - 0.5) * depth * u_parallax;\n    \n    p.x += sin(p.y * 2.0 + t) * 0.2;\n    p.y += cos(p.x * 2.0 + t * 0.8) * 0.2;\n    \n    float wave = sin(p.x * 1.5 + t) * cos(p.y * 1.2 - t * 0.5);\n    wave += sin(p.y * 3.0 + t * 1.2) * 0.2;\n    \n    float edgeWidth = mix(1.2, 0.05, u_sharpness);\n    return smoothstep(-edgeWidth, edgeWidth, wave);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    uv *= u_zoom;\n    \n    float t = iTime * u_speed * 0.2;\n    \n    // Mouse interaction for the camera \"lean\"\n    vec2 mouseOffset = (iMouse.xy / iResolution.xy - 0.5) * 0.2 * u_parallax;\n    uv -= mouseOffset;\n\n    // Enhanced Palette\n    vec3 colorA = vec3(0.01, 0.02, 0.06); // Deep Space\n    vec3 colorB = vec3(0.1, 0.4, 0.9);    // Vivid Electric Blue\n    vec3 colorC = vec3(0.7, 0.2, 0.8);    // Rich Magenta/Violet\n    vec3 colorD = vec3(1.0, 0.8, 0.4);    // Warm Golden Ember\n\n    // Apply color shift\n    colorB = mix(colorB, vec3(0.0, 0.8, 0.6), u_color_shift);\n    colorC = mix(colorC, vec3(0.9, 0.1, 0.2), u_color_shift);\n\n    // Initial background gradient with depth\n    vec3 finalColor = mix(colorA, colorB * 0.3, (uv.y / u_zoom) + 0.5);\n    \n    // Layered Depth Rendering\n    float layers = clamp(u_complexity, 1.0, 10.0);\n    for(float i = 0.0; i < 10.0; i++) {\n        if(i >= layers) break;\n        \n        // i represents depth (0 is front, higher is further)\n        float z = i + 1.0;\n        float flow = organicWave(uv * (1.0 + i * 0.1), z, i * 1.5);\n        \n        float lowEdge = mix(0.3, 0.48, u_sharpness);\n        float highEdge = mix(0.7, 0.52, u_sharpness);\n        float mask = smoothstep(lowEdge, highEdge, flow);\n        \n        // Dynamic layer coloring\n        vec3 waveColor = mix(colorB, colorC, sin(i * 0.8 + t) * 0.5 + 0.5);\n        \n        // Depth-based \"Fog\" effect to push layers back\n        float depthFog = exp(-i * u_fog_density);\n        waveColor = mix(colorA, waveColor, depthFog);\n        \n        // Inject bass reactivity\n        waveColor += colorD * (u_bass * 0.4 * depthFog); \n        \n        float alphaFactor = mix(0.2, 0.6, u_sharpness) * (1.0 / z);\n        finalColor += waveColor * mask * alphaFactor * 0.8;\n    }\n    \n    // Depth Magic: Volume Glow\n    float dist = length(uv + mouseOffset * 2.0);\n    float pulse = (sin(t * 2.0) * 0.05 + 0.95) * (1.0 + u_mid * 0.3);\n    float glowPower = mix(4.0, 10.0, u_sharpness);\n    float glow = exp(-dist * (glowPower / (max(u_glow_intensity, 0.1) * pulse * u_zoom)));\n    finalColor += colorD * glow * 0.6;\n\n    // Floating Particles with Parallax\n    for(float i = 0.0; i < 15.0; i++) {\n        float p_depth = fract(i * 0.231 + t * 0.1); // Move particles through Z space\n        float p_t = t + i * 123.456;\n        \n        // Parallax position\n        vec2 p_pos = vec2(sin(p_t * 0.5) * 1.5, cos(p_t * 0.3) * 0.8) * u_zoom;\n        p_pos += mouseOffset * (1.0 / p_depth) * u_parallax;\n        \n        float p_size = (0.002 + 0.015 * (1.0 - p_depth)) * u_zoom;\n        float p_dist = length(uv - p_pos);\n        float p_edge = mix(0.04, 0.002, u_sharpness) * u_zoom;\n        \n        // Particles glow more when closer (smaller p_depth)\n        finalColor += colorD * (smoothstep(p_size + p_edge, p_size, p_dist) * 0.5 * (1.0 - p_depth));\n    }\n\n    // --- Post Processing ---\n    finalColor = saturate(finalColor, u_saturation);\n    finalColor = contrast(finalColor, u_contrast);\n    finalColor *= u_brightness_fix;\n\n    // Vignette\n    vec2 screenUV = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    float vignette = smoothstep(2.2, 0.3, length(screenUV));\n    finalColor *= vignette;\n\n    // Tone Mapping\n    finalColor = pow(finalColor, vec3(1.05)); \n    finalColor = finalColor / (1.0 + finalColor * 0.15);\n\n    float alpha = u_alpha_fade * vignette;\n    fragColor = vec4(finalColor, alpha);\n}",
