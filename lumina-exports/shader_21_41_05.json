  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_sparkle;\nuniform float u_glow;\nuniform float u_hue;   // Bottom Color\nuniform float u_hue2;  // Top Color\nuniform float u_line_count; // Number of layered lines\n\n// New Silk Specific Parameters\nuniform float u_silk_specular;\nuniform float u_black_depth;\n\nout vec4 fragColor;\n\n// --- Helper Functions --\n\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// HSB to RGB Conversion\nvec3 hsb2rgb(vec3 c) {\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\n// Dual-Hue Palette Logic modified for Silky Black feel\nvec3 getLayerColor(float i, float total, float hue1, float hue2, float blackDepth) {\n    float t = i / total; \n    float h = mix(hue1, hue2, t);\n    \n    // For \"Silky Black\", we suppress base brightness but keep hue in reflections\n    float sat = mix(0.8, 0.2, t);\n    float bri = mix(0.1, 0.4, t) * (1.0 - blackDepth);\n    \n    return hsb2rgb(vec3(h, sat, bri));\n}\n\nfloat getDust(vec2 uv, float t) {\n    float gridSize = 25.0; \n    vec2 id = floor(uv * gridSize);\n    vec2 f = fract(uv * gridSize);\n    float r = hash(id);\n    vec2 pos = vec2(r, fract(r * 12.34));\n    float d = distance(f, pos);\n    float size = 0.02 * (0.5 + 0.5 * sin(t * 2.0 + r * 15.0));\n    return smoothstep(size, size * 0.5, d) * r; \n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // Safety Fallbacks\n    float spd = (u_speed <= 0.0) ? 0.3 : u_speed;\n    float time = iTime * spd;\n    float scale = (u_scale <= 0.0) ? 1.0 : u_scale;\n    float sparkleInt = (u_sparkle <= 0.0) ? 1.0 : u_sparkle;\n    float glowInt = (u_glow <= 0.0) ? 1.5 : u_glow;\n    int lineCount = int(clamp(u_line_count, 5.0, 30.0));\n    \n    float hue1 = u_hue; \n    float hue2 = u_hue2;\n\n    // Background: Deep void\n    vec3 bgCol = vec3(0.01) * (1.0 - u_black_depth);\n    vec3 finalColor = bgCol;\n\n    // Loop through layers to create sheet depth\n    for(int i = 0; i < 30; i++) {\n        if(i >= lineCount) break;\n        \n        float layerIndex = float(i);\n        float totalLayers = float(lineCount);\n        \n        // --- Wave Logic (Silky Flow) ---\n        float freq = 1.2 + layerIndex * 0.15;\n        float waveHeight = sin(uv.x * freq + time + layerIndex * 0.5) * 0.25; \n        waveHeight += sin(uv.x * 2.5 - time * 0.8 + layerIndex) * 0.12; \n        waveHeight *= scale;\n        \n        float stepSize = 1.6 / totalLayers;\n        float yOffset = -0.8 + (layerIndex * stepSize); \n        float surfaceY = waveHeight + yOffset;\n\n        // Mask for the sheet body\n        float fillMask = smoothstep(0.01, -0.01, uv.y - surfaceY);\n        \n        // Specular Sheen (The \"Silk\" highlight)\n        // We calculate a highlight based on the derivative of the wave\n        float slope = dFdx(surfaceY) * 10.0;\n        float specular = exp(-abs(uv.y - surfaceY) * 20.0) * pow(abs(sin(uv.x * 2.0 + time)), 3.0);\n        specular += exp(-abs(uv.y - (surfaceY - 0.02)) * 30.0) * u_silk_specular;\n\n        // Edge Glow\n        float edgeDist = abs(uv.y - surfaceY);\n        float edgeGlow = exp(-edgeDist * 25.0) * glowInt; \n\n        // --- Color Logic ---\n        // Base color is very dark to simulate black fabric\n        vec3 col = getLayerColor(layerIndex, totalLayers, hue1, hue2, u_black_depth);\n        \n        // Highlight color (Reflecting the hues)\n        vec3 reflectCol = hsb2rgb(vec3(mix(hue1, hue2, layerIndex/totalLayers), 0.4, 0.8));\n        \n        // --- Sparkles (Dust on silk) ---\n        vec2 dustUV = uv;\n        dustUV.x -= time * 0.05 + (layerIndex * 0.02); \n        float sparkles = getDust(dustUV + vec2(layerIndex * 1.5, 0.0), time);\n        \n        // --- Composition ---\n        float opacity = 1.0 / totalLayers;\n        \n        // Layer body (dark)\n        finalColor += col * fillMask * opacity; \n        \n        // Silk specular highlights (This gives it the \"Black Silk\" look)\n        finalColor += reflectCol * specular * 0.4 * u_silk_specular;\n        \n        // Edge rim lighting\n        finalColor += reflectCol * edgeGlow * (1.2 / totalLayers); \n        \n        // Fine sparkles\n        vec3 sparkleCol = mix(reflectCol, vec3(1.0), 0.5);\n        finalColor += sparkleCol * sparkles * fillMask * sparkleInt * 0.5;\n    }\n\n    // High contrast finish for silk\n    finalColor *= 1.3 - length(uv0) * 0.6;\n    finalColor = pow(finalColor, vec3(1.1)); // Crush blacks further\n    finalColor = smoothstep(0.0, 1.1, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
