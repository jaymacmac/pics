  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// User Parameters (Preserved)\nuniform float u_speed;\nuniform float u_fov;\nuniform float u_camera_dist;\nuniform float u_glow_intensity;\nuniform float u_complexity; \nuniform float u_viscosity;\nuniform float u_paper_texture;\nuniform float u_metallic_shine;\n\n// New control for bright whites\nuniform float u_bloom_brightness;\n\nout vec4 fragColor;\n\n// --- UTILS ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Pseudo-random noise for texture\nfloat noise(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\n// Gold Palette (Rich metallic colors)\nvec3 getGoldPalette(float t) {\n    // Gold tones: Deep bronze to bright yellow-white\n    vec3 color1 = vec3(0.3, 0.2, 0.05); // Deep Bronze\n    vec3 color2 = vec3(1.0, 0.85, 0.4); // Classic Gold\n    vec3 color3 = vec3(1.0, 0.98, 0.9); // Highlight Gold (whitened further)\n    \n    float mixFactor = sin(t * 2.0) * 0.5 + 0.5;\n    return mix(color1, mix(color2, color3, mixFactor), mixFactor);\n}\n\nvoid main() {\n    // 1. Coordinate Setup\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv_orig = uv;\n    \n    // Use u_fov as a zoom control\n    uv *= (3.0 - u_fov); \n    \n    float t = iTime * u_speed * 0.15;\n    \n    // 2. Liquid Distortion (The \"Molten Gold\" warp)\n    vec2 p = uv;\n    float flow = 0.0;\n    \n    for(float i = 1.0; i <= u_complexity; i++) {\n        // Distort coordinates to simulate fluid motion\n        p.x += 0.3 / i * sin(i * 3.0 * p.y + t + u_viscosity * 5.0);\n        p.y += 0.3 / i * cos(i * 3.0 * p.x + t + u_viscosity * 5.0);\n        \n        // Repurpose camera_dist for spatial shifting\n        p *= rot(u_camera_dist * 0.05);\n        \n        // Track displacement for shading\n        flow += length(p - uv);\n    }\n    \n    // 3. Distance Fields for the Gold shapes\n    float d = length(p) - 0.5;\n    // Sharp edges for the metallic flakes, smoothed by u_glow_intensity\n    float metallicMask = smoothstep(0.7, 0.2, abs(d * 0.4));\n    metallicMask += exp(-abs(d) * 4.0) * u_glow_intensity;\n    \n    // 4. Color Compositing (Black & Gold)\n    vec3 goldBase = getGoldPalette(flow * 0.2 + t * 0.1);\n    \n    // Background is Pure Black\n    vec3 finalCol = vec3(0.0);\n    \n    // Add the gold pigment\n    finalCol = mix(finalCol, goldBase, clamp(metallicMask, 0.0, 1.0));\n    \n    // 5. Metallic Surface Reflections (Pushed to bright white highlights)\n    // Simulate a fake environment reflection (Specularity)\n    vec3 n = normalize(vec3(dFdx(flow), dFdy(flow), 0.05)); // Sharpened normal\n    vec3 lightDir = normalize(vec3(sin(t), cos(t), 1.0));\n    \n    // Higher power for sharper, whiter highlights\n    float spec = pow(max(0.0, dot(n, lightDir)), 24.0) * u_metallic_shine * u_bloom_brightness;\n    \n    // Add bright metallic highlights (Incandescent white-gold)\n    finalCol += spec * vec3(1.0, 0.98, 0.95) * metallicMask;\n    \n    // 6. Paper/Metal Grain Texture\n    float grain = noise(gl_FragCoord.xy * 0.05) * u_paper_texture;\n    finalCol += (grain * goldBase * 0.5); // Grain only visible on gold\n\n    // 7. Post Processing\n    // Vignette\n    finalCol *= 1.1 - dot(uv_orig, uv_orig) * 0.5;\n    \n    // Contrast boost for that \"Pure Black\" look, while keeping whites clipped high\n    finalCol = pow(finalCol, vec3(0.95)); // Slightly lift the gamma for intensity\n    finalCol = smoothstep(0.0, 1.0, finalCol);\n    \n    // Final clamp to ensure whites pop against the darkness\n    fragColor = vec4(finalCol, 1.0);\n}",
