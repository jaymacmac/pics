  "code": "uniform float iTime;\nuniform vec3 iResolution;\nuniform vec4 iMouse;\nuniform float iDist;          // Control Zoom/Scale\nuniform float iIntensity;     // Control Brightness/Glow\nuniform float u_segments;     // Number of radial slices\nuniform float u_speed;        // Speed of internal rotation\nuniform float u_pulse_speed;  // Global speed multiplier for animation\nuniform float u_purple_tint;  // Control for the purple highlight\nuniform float u_neural_complexity; // Fractal iterations for neural paths\nuniform float u_flow_depth;   // Perception of 3D depth in flow\n\n// New Parameters for organic flow\nuniform float u_wave_turbulence; \nuniform float u_cloud_softness;\n\nvarying vec2 vUv;\n\n// Palette function for color cycling\nvec3 palette( float t ) {\n    vec3 a = vec3(0.5, 0.5, 0.5);\n    vec3 b = vec3(0.5, 0.5, 0.5);\n    vec3 c = vec3(1.0, 1.0, 1.0);\n    vec3 d = vec3(0.263, 0.416, 0.557);\n    return a + b * cos( 6.28318 * (c * t + d) );\n}\n\n// 2D Rotation helper\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Simple noise-based warping for \"cloud/wave\" behavior\nfloat noise(vec2 p) {\n    return sin(p.x) * sin(p.y);\n}\n\nvoid main() {\n    // Normalize coordinates\n    vec2 uv = (vUv * 2.0 - 1.0);\n    uv.x *= iResolution.x / iResolution.y;\n    \n    // Time driver\n    float t = iTime * u_pulse_speed;\n    \n    // Organic wave distortion (Pre-processing)\n    // This creates the \"underwater\" or \"cloud-like\" shifting\n    vec2 warp = uv;\n    warp += 0.2 * sin(warp.yx * 4.0 + t * 2.0);\n    warp += 0.1 * cos(warp.xy * 8.0 - t * 1.5);\n    uv = mix(uv, warp, u_wave_turbulence);\n\n    // Kaleidoscope/Radial Pre-process\n    float r = length(uv);\n    float angle = atan(uv.y, uv.x);\n    float segmentAngle = 6.28318 / max(u_segments, 1.0);\n    angle = mod(angle, segmentAngle);\n    angle = abs(angle - segmentAngle * 0.5);\n    uv = vec2(cos(angle), sin(angle)) * r;\n\n    // Apply global zoom\n    uv *= (3.0 / clamp(iDist, 0.1, 20.0));\n\n    // Iterative Ray/Slice accumulation for 3D depth\n    vec3 finalColor = vec3(0.0);\n    for (float j = 0.0; j < 3.0; j++) {\n        // Offset each \"layer\" in depth\n        float depth = j * u_flow_depth * 0.1;\n        vec2 layerUv = uv * (1.0 + depth);\n        \n        // Internal layer rotation\n        layerUv *= rot(iTime * u_speed * 0.2 + j);\n        \n        vec2 uv0 = layerUv;\n        \n        // Iterative fractal folding to simulate neural dendrites\n        for (float i = 0.0; i < u_neural_complexity; i++) {\n            // Fold the space with organic offsets\n            layerUv = abs(layerUv) - 0.5;\n            // Add a slight \"breeze\" to the folds\n            layerUv += 0.05 * sin(t + i * 1.2); \n            layerUv *= rot(t * 0.3 + i * 0.2);\n            layerUv = fract(layerUv * 1.5) - 0.5;\n\n            // Distance to neural \"synapses\" / wave crests\n            float d = length(layerUv) * exp(-length(uv0));\n\n            // Color based on depth and iteration\n            vec3 col = palette(length(uv0) + i * 0.15 + t * 1.2 + j * 0.3);\n\n            // Wave pulses\n            d = sin(d * (6.0 + j) + t * 4.0) / 8.0;\n            d = abs(d);\n\n            // Cloud-like softness logic\n            // Instead of a sharp line, we use a broader gradient for a gaseous feel\n            float spark = pow( (0.01 * u_cloud_softness) / d, 0.95);\n            \n            // Apply depth fading\n            spark *= (1.0 / (1.0 + depth * 1.5));\n\n            finalColor += col * spark;\n        }\n    }\n    \n    // --- Post-Processing ---\n    // Calculate luminance for highlights\n    float luminance = dot(finalColor, vec3(0.2126, 0.7152, 0.0722));\n    \n    // Purple Tone mapping (Synaptic Hue)\n    vec3 purpleTone = vec3(0.7, 0.4, 1.0);\n    \n    // Mix the original color with a purple-toned version specifically in the highlights\n    vec3 tintedColor = mix(finalColor, finalColor * purpleTone + vec3(0.05, 0.0, 0.15), u_purple_tint * smoothstep(0.1, 0.9, luminance));\n    \n    // Add a slight vignette for 3D tunnel feel\n    float vignette = smoothstep(1.8, 0.4, length(vUv - 0.5) * 2.0);\n    tintedColor *= vignette;\n\n    // Final intensity multiplier\n    gl_FragColor = vec4(tintedColor * iIntensity, 1.0);\n}",
