  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_sparkle;\nuniform float u_glow;\nuniform float u_hue;   \nuniform float u_hue2;  \n\n// AI Aesthetic Parameters\nuniform float u_neuro_complexity; \nuniform float u_chromatic_aberration; \nuniform float u_bass; \nuniform float u_glitch_intensity; \n\n// \"Mad\" Parameters\nuniform float u_rage_intensity; \nuniform float u_distortion_warp; \n\n// Stretchy Blob Parameters\nuniform float u_stretch_amount;\nuniform float u_blob_viscosity;\n\n// New Smoothness Parameter\nuniform float u_smoothness;\n\nout vec4 fragColor;\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat hash(float n) {\n    return fract(sin(n) * 43758.5453123);\n}\n\n// Seamless FBM using a noise function that doesn't rely on mod(iTime) directly\nfloat fbm(vec2 p, float rage, float bassParam, float time) {\n    float v = 0.0;\n    float a = 0.5;\n    vec2 shift = vec2(100.0);\n    for (int i = 0; i < 4; ++i) {\n        v += a * (sin(p.x + time * 0.1) + cos(p.y - time * 0.1));\n        p = rot(0.5 + rage * 0.2) * p * (1.8 + bassParam * 0.5) + shift;\n        a *= 0.5;\n    }\n    return v;\n}\n\nvec3 hsb2rgb(vec3 c) {\n    // Smoothed HSB to RGB to prevent banding during fast hue shifts\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\nvoid main() {\n    // --- SETTINGS FIXED TO YOUR PARAMS ---\n    float speed = (u_speed <= 0.001) ? 0.0 : u_speed * 0.1; \n    float scale = (u_scale <= 0.1) ? 0.9 : u_scale;\n    float sparkleInt = u_sparkle; \n    float glowInt = u_glow;\n    float hue1 = u_hue;\n    float hue2 = u_hue2;\n    \n    float neuro = u_neuro_complexity; \n    float caParam = u_chromatic_aberration;\n    float bass = (u_bass > 0.0) ? u_bass : 0.0;\n    float glitch = u_glitch_intensity;\n    float rage = u_rage_intensity;\n    float warp = u_distortion_warp;\n\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n    \n    float time = iTime * speed;\n\n    // Apply \"Stretchy\" blooming effect to UVs over time\n    float stretchCycle = sin(time * 0.5) * 0.5 + 0.5;\n    float stretchFactor = 1.0 + stretchCycle * u_stretch_amount;\n    uv *= mix(1.0, 1.0 / stretchFactor, length(uv) * u_blob_viscosity);\n\n    // Smooth Shake\n    if (rage > 0.01) {\n        vec2 shake = vec2(sin(iTime * 20.0), cos(iTime * 17.0)) * rage * 0.005;\n        uv += shake;\n    }\n\n    // Glitch logic\n    if (glitch > 0.01) {\n        float sliceY = floor(uv.y * 20.0);\n        float glitchChance = fract(sin(sliceY * 12.9898) * 43758.5453);\n        if (glitchChance > 0.98 - glitch * 0.05) {\n            uv.x += (sin(iTime * 50.0 + sliceY) * 0.02) * glitch;\n        }\n    }\n\n    // Fluid background\n    float fluid = fbm(uv * (2.0 + warp) - time * 0.2, rage, bass, time) * (neuro + rage);\n    uv += fluid * (0.05 + warp * 0.05 + stretchCycle * 0.1);\n\n    vec3 bgCol = hsb2rgb(vec3(mix(hue1, hue2, 0.5), mix(0.8, 1.0, rage), 0.03 + max(fluid, 0.0) * 0.02));\n    vec3 finalColor = bgCol;\n\n    const int LAYERS = 12;\n    \n    for (int i = 0; i < LAYERS; i++) {\n        float fi = float(i);\n        \n        // Use a continuous loop for depth\n        float progress = fi / float(LAYERS);\n        float z = fract(progress - time * 0.1);\n        \n        // Deepening the fade at edges to hide the pop\n        float fade = smoothstep(0.0, 0.25 * u_smoothness, z) * smoothstep(1.0, 0.75 / u_smoothness, z);\n        \n        // Dynamic layer scaling\n        float layerScale = mix(20.0, 1.0, 1.0 - z) / (scale * mix(1.0, stretchFactor, 0.5));\n        vec2 p = uv * layerScale;\n        \n        // Rotation and \"Breathing\" movement\n        p *= rot(z * warp * 2.0 + time * 0.05 + fi);\n        float stretchOsc = sin(time * 0.8 + fi) * u_stretch_amount * 0.2;\n        p += vec2(sin(p.y * 0.5 + time * 0.5 + stretchOsc), cos(p.x * 0.5 - time * 0.5 - stretchOsc)) * (0.5 + stretchCycle);\n        \n        float ca = (caParam + rage * 0.5) * 0.2 * (1.0 - z);\n        float dR = length(sin(p - ca));\n        float dG = length(sin(p));\n        float dB = length(sin(p + ca));\n        \n        float radius = 0.4 * (1.0 + bass * 0.8 + stretchCycle * 0.3);\n        \n        float coreR = smoothstep(radius + 0.1, radius - 0.1, dR);\n        float coreG = smoothstep(radius + 0.1, radius - 0.1, dG);\n        float coreB = smoothstep(radius + 0.1, radius - 0.1, dB);\n        \n        float glowSharpness = 8.0 / (glowInt + 0.001); \n        float glowR = exp(-abs(dR - radius) * glowSharpness) * glowInt * (1.0 + rage);\n        float glowG = exp(-abs(dG - radius) * glowSharpness) * glowInt;\n        float glowB = exp(-abs(dB - radius) * glowSharpness) * glowInt;\n        \n        // FIX: Replaced fract(fi/LAYERS + time) which snaps at the wrap-around point.\n        // Instead, we use a continuous sine-wave oscillation to interpolate between hue1 and hue2\n        // or a slow linear progression that is mapped into the HSB cycle.\n        // We use 'fi' and 'time' inside a trig function to ensure smoothness across the loop.\n        float hueOsc = sin(time * 0.2 + progress * 6.283) * 0.5 + 0.5;\n        float layerHue = mix(hue1, hue2, hueOsc);\n        \n        if (rage > 0.01) {\n            // Smoothly modulate the hue during rage mode\n            float rageHueShift = sin(time * 2.0 + fi) * 0.5 + 0.5;\n            layerHue = mix(layerHue, rageHueShift, rage * 0.4); \n        }\n        \n        vec3 col = hsb2rgb(vec3(layerHue, mix(0.7, 1.0, rage + bass), 1.0));\n        \n        vec3 layerColor = vec3(0.0);\n        layerColor.r += col.r * (glowR + coreR * 0.3);\n        layerColor.g += col.g * (glowG + coreG * 0.3);\n        layerColor.b += col.b * (glowB + coreB * 0.3);\n        \n        float sparkVal = max(0.0, sin(p.x * 8.0 + time * 0.5) * sin(p.y * 8.0 - time * 0.7));\n        sparkVal = pow(sparkVal, 15.0) * sparkleInt * 8.0;\n        \n        vec3 sparkleCol = mix(vec3(1.0), col, 0.3);\n        layerColor += sparkleCol * sparkVal * glowG; \n        \n        finalColor += layerColor * fade * (1.5 - z);\n    }\n\n    // Vignette\n    finalColor *= (1.2 + rage * 0.5) - length(uv0) * (0.8 + rage * 0.6 + stretchCycle * 0.2);\n    \n    // Final clamp and contrast adjustment\n    finalColor = pow(max(finalColor, 0.0), vec3(0.9 - rage * 0.3)); \n    finalColor = smoothstep(-0.05, 1.15 + rage * 0.5 + stretchCycle * 0.1, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
