  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// Parameter uniforms\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;         \nuniform float u_glow_intensity;\nuniform float u_complexity;\nuniform float u_line_width;\n\nout vec4 fragColor;\n\n// --- UTILS ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvoid main() {\n    // 1. Setup Coordinates\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // Convert 3D camera concepts to 2D space\n    float zoom = u_camera_dist * 0.2;\n    uv *= zoom;\n    \n    // Apply a slight perspective/warp based on u_fov\n    uv /= (1.0 + length(uv) * (u_fov * 0.2));\n    \n    float t = iTime * u_speed * 0.2;\n    \n    // 2. MINIMALIST STRAND PATTERN\n    // Starting with a black background as requested (\"remove the rest\")\n    vec3 finalCol = vec3(0.0);\n\n    vec2 p = uv;\n    p *= rot(t * 0.1); // Slow global rotation\n    \n    // Focus purely on the line geometry\n    for(float i = 0.0; i < u_complexity; i++) {\n        // Spatial distortion for the strands\n        p *= rot(0.3 + i * 0.1 + t * 0.02);\n        \n        // Create wavy organic strand shapes\n        float wave = sin(p.y * 1.5 + t + i) * 0.2;\n        \n        // The core line distance\n        float dist_strand = abs(p.x + wave) - u_line_width;\n        \n        // Coloring based on iteration and time\n        vec3 layer_color = mix(\n            vec3(0.0, 0.8, 1.0), // Electric Blue\n            vec3(0.8, 0.2, 1.0), // Ethereal Purple\n            sin(i * 0.8 + t * 0.5) * 0.5 + 0.5\n        );\n        \n        // Accumulate glow around the lines\n        // Adjusted to be tighter and cleaner for the minimalist look\n        float glow = 0.001 / (0.002 + pow(abs(dist_strand), 1.2));\n        \n        finalCol += layer_color * glow * u_glow_intensity;\n    }\n    \n    // 3. POST-PROCESSING\n    // Gentle vignette to clean edges\n    float vign = length((gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y);\n    finalCol *= smoothstep(1.5, 0.5, vign);\n    \n    // Gamma correction\n    finalCol = pow(finalCol, vec3(0.4545));\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
