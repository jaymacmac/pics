  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\nuniform float u_speed;\nuniform float u_camera_dist;\nuniform float u_orbit_radius; \nuniform float u_fov;\nuniform float u_twist;\nuniform float u_thickness;\nuniform float u_glow_intensity;\nuniform float u_wave_height;\nuniform float u_wave_freq;\nuniform float u_darkness;\nuniform float u_color_saturation;\nuniform float u_viscosity;\n\nout vec4 fragColor;\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat smin(float a, float b, float k) {\n    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n    return mix(b, a, h) - k * h * (1.0 - h);\n}\n\nfloat noise(vec2 p) {\n    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nfloat getCarpetWave(vec2 p) {\n    float t = iTime * u_speed;\n    float wave = sin(p.x * u_wave_freq + t) * cos(p.y * (u_wave_freq * 0.5) + t * 0.3);\n    wave += (0.5 - u_viscosity * 0.3) * sin(p.x * u_wave_freq * 2.1 - t * 1.2);\n    wave *= u_wave_height;\n    return wave;\n}\n\nfloat map(vec3 p) {\n    float t = iTime * u_speed * 0.5;\n    float waveHeight = getCarpetWave(p.xz);\n    float floorDist = p.y - waveHeight;\n    float strands = 1e10;\n    \n    // BACK TO ORIGINAL X-AXIS STRANDS\n    for(float i = 0.0; i < 3.0; i += 1.0) {\n        float offset = i * 2.0;\n        vec2 pathPoint = vec2(p.x, sin(p.x * 0.2 + t + offset) * 5.0);\n        float pathWave = getCarpetWave(vec2(p.x, pathPoint.y));\n        vec3 strandPos = vec3(p.x, pathWave + 0.5, pathPoint.y);\n        vec3 q = p - strandPos;\n        q.xz *= rot(p.x * u_twist + t);\n        \n        float pulse = 0.5 + 0.3 * sin(p.x * 2.0 + t * 3.0);\n        float ribbon = length(q.yz) - u_thickness * pulse;\n        strands = smin(strands, ribbon, 1.2);\n    }\n    return smin(floorDist, strands, 0.8);\n}\n\nvec3 getNormal(vec3 p) {\n    vec2 e = vec2(0.005, 0.0);\n    return normalize(vec3(\n        map(p + e.xyy) - map(p - e.xyy),\n        map(p + e.yxy) - map(p - e.yxy),\n        map(p + e.yyx) - map(p - e.yyx)\n    ));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    float globalTime = iTime * u_speed;\n    \n    // ORBITING CAMERA\n    float angle = globalTime * 0.5;\n    vec3 ro = vec3(cos(angle) * u_orbit_radius, u_camera_dist, sin(angle) * u_orbit_radius);\n    \n    // STABILIZED TARGET: Look at the center area of the strands\n    vec3 ta = vec3(ro.x + cos(angle + 1.57), 0.0, ro.z + sin(angle + 1.57));\n    \n    vec3 cw = normalize(ta - ro);\n    vec3 cu = normalize(cross(cw, vec3(0, 1, 0)));\n    vec3 cv = normalize(cross(cu, cw));\n    vec3 rd = normalize(uv.x * cu + uv.y * cv + u_fov * cw);\n\n    float t = 0.0, d = 0.0, glow = 0.0;\n    vec3 col = vec3(0.0);\n    \n    for(int i = 0; i < 90; i++) {\n        vec3 p = ro + rd * t;\n        d = map(p);\n        glow += (0.01 / (0.05 + d * d)) * (1.0 - u_darkness * 0.5);\n        if(d < 0.002 || t > 40.0) break; // Tighter clip distance stops \"infinite stretching\"\n        t += d * 0.7; \n    }\n\n    if(t < 40.0) {\n        vec3 p = ro + rd * t;\n        vec3 n = getNormal(p);\n        vec3 ref = reflect(rd, n);\n        float ao = clamp(0.5 + 0.5 * n.y, 0.0, 1.0);\n        float fres = pow(1.0 + dot(rd, n), 4.0);\n        \n        vec3 bloodBase = vec3(0.4, 0.0, 0.01);\n        vec3 bloodBright = vec3(0.9, 0.05, 0.05);\n        vec3 palette = mix(bloodBase, bloodBright, 0.5 + 0.5 * cos(p.x * 0.1 + p.z * 0.1));\n        \n        vec3 baseCol = mix(vec3(0.01, 0.0, 0.0), palette, u_color_saturation);\n        \n        vec3 lp = ro + vec3(-5.0, 10.0, -5.0);\n        vec3 ld = normalize(lp - p);\n        float diff = pow(max(dot(n, ld), 0.0), 1.0 + u_darkness * 3.0);\n        float spec = pow(max(dot(ref, ld), 0.0), 30.0);\n        \n        col = baseCol * diff + (spec * 0.8) + (fres * bloodBright * 0.4);\n        col *= ao;\n    }\n    \n    vec3 glowCol = vec3(1.0, 0.0, 0.1) * (0.8 + 0.2 * sin(globalTime));\n    col += glow * glowCol * u_glow_intensity;\n    \n    vec3 fogColor = vec3(0.01, 0.0, 0.0);\n    col = mix(col, fogColor, smoothstep(10.0, 40.0, t));\n\n    // Banding Fix\n    float dither = noise(gl_FragCoord.xy + iTime) / 255.0;\n    col += dither;\n\n    fragColor = vec4(clamp(pow(col, vec3(0.9)), 0.0, 1.0), 1.0);\n}\n\n/* CONFIG\n{\n  \"parameters\": [\n    { \"name\": \"u_speed\", \"label\": \"Speed\", \"type\": \"float\", \"default\": 0.2, \"min\": 0, \"max\": 5 },\n    { \"name\": \"u_camera_dist\", \"label\": \"Height\", \"type\": \"float\", \"default\": 10.0, \"min\": 2, \"max\": 20 },\n    { \"name\": \"u_orbit_radius\", \"label\": \"Orbit Radius\", \"type\": \"float\", \"default\": 15.0, \"min\": 5, \"max\": 40 },\n    { \"name\": \"u_fov\", \"label\": \"FOV\", \"type\": \"float\", \"default\": 1.5, \"min\": 0.5, \"max\": 2.5 },\n    { \"name\": \"u_twist\", \"label\": \"Twist\", \"type\": \"float\", \"default\": 0.1, \"min\": 0, \"max\": 1 },\n    { \"name\": \"u_thickness\", \"label\": \"Thickness\", \"type\": \"float\", \"default\": 0.8, \"min\": 0, \"max\": 1.5 },\n    { \"name\": \"u_glow_intensity\", \"label\": \"Glow\", \"type\": \"float\", \"default\": 0.03, \"min\": 0, \"max\": 0.5 },\n    { \"name\": \"u_wave_height\", \"label\": \"Wave Height\", \"type\": \"float\", \"default\": 1.0, \"min\": 0, \"max\": 2 },\n    { \"name\": \"u_wave_freq\", \"label\": \"Wave Freq\", \"type\": \"float\", \"default\": 0.8, \"min\": 0, \"max\": 2 },\n    { \"name\": \"u_darkness\", \"label\": \"Darkness\", \"type\": \"float\", \"default\": 1.0, \"min\": 0, \"max\": 1 },\n    { \"name\": \"u_color_saturation\", \"label\": \"Saturation\", \"type\": \"float\", \"default\": 0.8, \"min\": 0, \"max\": 1 },\n    { \"name\": \"u_viscosity\", \"label\": \"Viscosity\", \"type\": \"float\", \"default\": 0.7, \"min\": 0, \"max\": 1 }\n  ]\n}\n*/",
