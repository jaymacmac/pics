  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; \nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_saturation;\n\n// --- NEW CONTROLS ---\nuniform float u_tunnel_twist;\nuniform float u_triangle_round;\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\n// Triangle SDF for 2D cross section\nfloat sdEquilateralTriangle( vec2 p, float r ) {\n    const float k = sqrt(3.0);\n    p.x = abs(p.x) - r;\n    p.y = p.y + r/k;\n    if( p.x+k*p.y>0.0 ) p = vec2(p.x-k*p.y,-k*p.x-p.y)/2.0;\n    p.x -= clamp( p.x, -2.0*r, 0.0 );\n    return -length(p)*sign(p.y);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // rd: Ray direction using provided FOV logic\n    vec3 rd = normalize(vec3(uv, -1.0 / max(0.1, u_fov))); \n    \n    float t = iTime * ((u_speed <= 0.0) ? 0.2 : u_speed);\n    \n    // Accumulation\n    vec4 col = vec4(0.0);\n    \n    // Start distance: offset slightly to ensure we are looking AT the volume\n    float d = 0.5 + u_camera_dist; \n    \n    for(int i = 0; i < 80; i++) {\n        vec3 p = d * rd;\n        \n        // Move camera through the tunnel\n        p.z += t * 2.0;\n        \n        // Apply twist to the tunnel based on depth\n        float angle = p.z * u_tunnel_twist;\n        p.xy *= rot(angle);\n        \n        // Turbulence Loop\n        float scale = 1.5;\n        vec3 p_orig = p;\n        for(int j = 0; j < 4; j++) {\n            p.xy *= rot(t * 0.05 + float(j) * 0.3);\n            p += u_turbulence_strength * sin(p.yzx * scale - t) / scale;\n            scale *= 1.6;\n        }\n        \n        // Calculate Distance to Triangle Boundary\n        // u_cloud_height acts as the radius of the tunnel\n        float tri = sdEquilateralTriangle(p.xy, 1.5 * u_cloud_height);\n        \n        // We want the glow to be thickest near the triangle edge\n        // abs(tri) makes it follow the perimeter\n        float strands = 0.1 - abs(tri);\n        \n        // Step size logic\n        float stepSize = 0.04 + max(0.0, -strands) * 0.2;\n        d += stepSize;\n        \n        // Color logic based on depth and turbulence\n        float hue = fract(u_color_shift + p_orig.z * 0.05 + t * 0.1);\n        vec3 pigment = hsv2rgb(vec3(hue, max(0.4, u_saturation), 1.0));\n        \n        // Heat Map / Volume density\n        vec3 fireCol = mix(vec3(0.05, 0.0, 0.1), pigment, smoothstep(-0.5, 0.5, strands));\n        \n        // Glow logic\n        float density = 1.0 + u_density_factor;\n        float glow = exp(strands * (5.0 * density));\n        \n        // Accumulate with distance attenuation so it doesn't get too bright in center\n        col.rgb += fireCol * glow * (u_glow_intensity * 0.012);\n        \n        if (col.a > 0.98) break;\n    }\n    \n    // Tone Mapping\n    vec3 finalCol = col.rgb;\n    finalCol = 1.0 - exp(-finalCol * 1.2); // Filmic compression\n    \n    // Final Polish\n    finalCol = pow(finalCol, vec3(1.1, 1.0, 0.9));\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
