  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Parameter mappings\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_intensity;\nuniform float u_color_cycle;\nuniform float u_layers;\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\n// 2D Rotation Matrix\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Pseudo-random hash\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// Smooth Value Noise (Organic, gridless noise)\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    \n    // Cubic interpolation for buttery smooth gradients\n    f = f * f * (3.0 - 2.0 * f);\n    \n    float a = hash(i);\n    float b = hash(i + vec2(1.0, 0.0));\n    float c = hash(i + vec2(0.0, 1.0));\n    float d = hash(i + vec2(1.0, 1.0));\n    \n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\n// Fractal Brownian Motion (Organic clouds/fog)\nfloat fbm(vec2 p) {\n    float v = 0.0;\n    float a = 0.5;\n    mat2 shift = mat2(0.866, -0.5, 0.5, 0.866); \n    for (int i = 0; i < 4; i++) {\n        v += a * noise(p);\n        p = shift * p * 2.0;\n        a *= 0.5;\n    }\n    return v;\n}\n\n// Royal Blue & Gold Palette\nvec3 palette(float t) {\n    // These specific phase offsets create a perfect oscillation\n    // between rich Royal Blue and luminous Gold.\n    vec3 a = vec3(0.50, 0.40, 0.40); // Base brightness\n    vec3 b = vec3(0.50, 0.40, 0.40); // Contrast\n    vec3 c = vec3(1.00, 1.00, 1.00); // Frequency\n    vec3 d = vec3(0.00, 0.15, 0.45); // Phase shift (Red/Green peak for Gold, Blue peaks opposite)\n    \n    return a + b * cos(6.28318 * (c * t + d));\n}\n\n// Healing Neural Fog\nfloat getHealingFog(vec2 uv, float t) {\n    vec2 driftUV = uv * 3.0 + vec2(t * 0.1, t * -0.05);\n    float n = fbm(driftUV);\n    return smoothstep(0.4, 0.85, n);\n}\n\nvoid main() {\n    // 1. Correct Aspect Ratio UVs\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // 2. Timing\n    float spd = (u_speed <= 0.0) ? 0.15 : u_speed * 0.5;\n    float t = iTime * spd;\n\n    // --- Background (Royal Blue Abyss) ---\n    vec3 bgTop = vec3(0.0, 0.15, 0.5); // Rich Royal Blue\n    vec3 bgBottom = vec3(0.0, 0.02, 0.15); // Deep Navy/Indigo\n    \n    // The 2Hz Delta pulse applied to the background atmosphere\n    float deltaPulse = sin(iTime * 2.0 * spd) * 0.05; \n    bgTop += deltaPulse; \n    \n    vec3 finalColor = mix(bgBottom, bgTop, uv0.y + 0.5 + 0.1 * sin(t * 0.5));\n    \n    // 3. Layer Loop\n    float density = (u_layers <= 0.0) ? 4.0 : u_layers;\n    float scale = (u_scale <= 0.0) ? 1.0 : u_scale;\n    float brightness = (u_intensity <= 0.0) ? 1.2 : u_intensity;\n\n    for(float i = 0.0; i < 6.0; i++) {\n        if(i >= density) break;\n\n        // --- Cymatic Soundwave Distortion ---\n        vec2 waveUV = uv0 * (1.0 + scale * 0.3);\n        \n        // Slow, hypnotic rotation\n        waveUV *= rot(t * 0.05 + i * 1.2);\n\n        // Representation of 528Hz healing frequencies\n        float r = length(waveUV);\n        float harmonic = sin(r * 12.0 - t * 3.0 + i) * 0.5;\n        harmonic += cos(waveUV.x * 3.0 - t + i * 1.5) * 0.3;\n        \n        // Distance to the harmonic peaks (the \"soundwaves\")\n        float dist = abs(harmonic - 0.1);\n\n        // --- Gentle Sonic Glow ---\n        float coreGlow = exp(-dist * 8.0) * 0.5; \n        float softGlow = exp(-dist * 2.0) * 0.3; \n        \n        // --- Healing Fog Logic ---\n        vec2 fogUV = waveUV;\n        fogUV.x += harmonic * 0.3; \n        \n        float fogMap = getHealingFog(fogUV + vec2(i * 1.5, i * 2.5), t);\n        \n        float waveMask = exp(-dist * 1.5); \n        float fog = fogMap * waveMask * 1.5;\n\n        // 4. Coloring\n        float cycle = (u_color_cycle <= 0.0) ? 0.2 : u_color_cycle;\n        vec3 col = palette(r * 0.3 + i * 0.2 + t * cycle);\n        \n        // Fog color: Brilliant, warm Gold\n        vec3 fogCol = mix(col, vec3(1.0, 0.85, 0.2), 0.6);\n\n        // Accumulate: Sonic Waves + Healing Fog\n        finalColor += col * (coreGlow + softGlow) * brightness * 0.6;\n        finalColor += fogCol * fog * brightness;\n    }\n\n    // 5. Post-Processing\n    float vig = 1.0 - length(uv0) * 0.6;\n    finalColor *= vig;\n\n    // Smooth Tone Mapping to prevent burn-in\n    finalColor = smoothstep(-0.1, 1.2, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
