  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \nuniform sampler2D iChannel1; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; // Reused as tunnel radius\nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_tunnel_twist; \nuniform float u_exit_light_size; // New: Controls the size of the light at the end\nuniform float u_exit_light_bright; // New: Controls the brightness of the light at the end\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\n#define PI 3.14159265359\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// --- MAIN RENDER LOOP ---\nvoid main() {\n    // 1. Setup UVs and Ray Direction\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // Create the ray direction for a forward-moving perspective\n    vec3 rd = normalize(vec3(uv, 1.0 / u_fov)); \n    \n    // Animation Time\n    float t = iTime * u_speed;\n    \n    // Raymarching Variables\n    vec4 col = vec4(0.0);\n    float dist = u_camera_dist; \n    float stepSize = 0.0;\n    \n    // --- VOLUMETRIC MARCH ---\n    for(int i = 0; i < 80; i++) {\n        \n        // Current Position along Ray\n        vec3 p = dist * rd;\n        p.z += t; // Forward motion\n        \n        // Apply twist to the tunnel based on depth\n        p.xy *= rot(p.z * u_tunnel_twist + t * 0.1);\n        \n        // --- TURBULENCE LOOP (FBM) ---\n        float scale = 3.0;\n        for(int j = 0; j < 4; j++) {\n            p += u_turbulence_strength * sin(p.yzx * scale) / scale;\n            scale *= 1.8; \n            if (scale > 50.0) break;\n        }\n        \n        // --- CYLINDRICAL DENSITY CALCULATION ---\n        float radius = u_cloud_height * 2.0;\n        float tunnelDist = length(p.xy) - radius;\n        \n        // Calculate Step Size\n        float stepFactor = max(abs(tunnelDist), 0.02);\n        stepSize = stepFactor * 0.4;\n        \n        // Advance Ray\n        dist += stepSize;\n        \n        // --- COLOR ACCUMULATION ---\n        float angle = atan(p.y, p.x);\n        float hue = p.z * 0.5 + angle / PI + u_color_shift * 5.0;\n        \n        // Iridescent color mapping\n        vec3 baseColor = cos(hue - vec3(0.0, 2.0, 4.0)) * 0.5 + 0.5;\n        \n        // Glow logic based on proximity to the tunnel wall\n        float glow = exp(-abs(tunnelDist) * (10.0 / u_density_factor));\n        \n        // Accumulate intensity\n        col.rgb += baseColor * glow * (u_glow_intensity * 0.05) / (1.0 + dist * 0.5);\n        \n        // Optimization: early exit if color is saturated\n        if(col.a > 0.99) break;\n    }\n    \n    // --- THE LIGHT AT THE END OF THE TUNNEL ---\n    // A centralized glow that represents the exit/horizon\n    float exitGlow = pow(max(0.0, 1.0 - length(uv) / u_exit_light_size), 4.0);\n    vec3 exitColor = vec3(0.8, 0.9, 1.0) * exitGlow * u_exit_light_bright;\n    \n    // --- POST PROCESSING ---\n    vec3 finalCol = col.rgb + exitColor;\n    \n    // Contrast and Tone Mapping\n    finalCol = smoothstep(0.0, 1.2, finalCol);\n    finalCol = tanh(finalCol * 1.5); \n    \n    // Vignette\n    finalCol *= 1.0 - dot(uv, uv) * 0.5;\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
