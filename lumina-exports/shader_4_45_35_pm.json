  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- AUDIO INPUTS ---\nuniform float u_bass;\nuniform float u_mid;\nuniform float u_treble;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \nuniform sampler2D iChannel1; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; // Reused as tunnel radius\nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_tunnel_twist; \nuniform float u_exit_light_size; \nuniform float u_exit_light_bright; \n\n// --- NEW LUSHNESS CONTROLS ---\nuniform float u_bloom_amount;\nuniform float u_pulse_speed;\nuniform float u_chromatic_aberration;\nuniform float u_dither_strength;\n\n// --- NEW MONOCHROMATIC CONTROL ---\nuniform float u_color_spread; // Controls how much of the spectrum is visible at once\n\n// --- ETHEREAL GOD-LIKE CONTROLS ---\nuniform float u_god_ray_strength;\nuniform float u_fog_density;\nuniform float u_ethereal_shimmer;\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\n#define PI 3.14159265359\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Pseudo-random function for dithering\nfloat hash(vec2 p) {\n    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\n// Helper for color variations - Tuned for Ethereal Whites/Golds/Soft Blues\nvec3 palette(float t) {\n    // Ethereal palette: Silvery whites, golden highlights, soft cyans\n    vec3 a = vec3(0.8, 0.8, 0.9);\n    vec3 b = vec3(0.2, 0.2, 0.1);\n    vec3 c = vec3(1.0, 1.0, 1.0);\n    vec3 d = vec3(0.3, 0.2, 0.5);\n    \n    float phase = u_color_shift + (iTime * 0.05); \n    float spread_t = phase + (t * u_color_spread);\n    \n    return a + b * cos(2.0 * PI * (c * spread_t + d));\n}\n\n// --- MAIN RENDER LOOP ---\nvoid main() {\n    // 1. Setup UVs and Ray Direction\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // Audio Reactivity Integration\n    float bassBoost = u_bass * 0.3;\n    float trebleSparkle = u_treble * 0.4;\n    float pulse = sin(iTime * u_pulse_speed) * 0.05;\n    \n    // Chromatic Aberration offset calculation\n    float chroma = u_chromatic_aberration * 0.015 * length(uv);\n    \n    // Create the ray direction for a forward-moving perspective\n    vec3 rd = normalize(vec3(uv, 1.0 / (u_fov + pulse))); \n    \n    // Animation Time\n    float t = iTime * u_speed;\n    \n    // Raymarching Variables\n    float dither = hash(uv + fract(iTime)) * 0.05 * u_dither_strength;\n    float dist = u_camera_dist + dither; \n    \n    vec4 col = vec4(0.0);\n    float stepSize = 0.0;\n    float accumGlow = 0.0;\n    \n    // --- VOLUMETRIC MARCH ---\n    for(int i = 0; i < 90; i++) { // Increased steps for silkier volume\n        \n        // Current Position along Ray\n        vec3 p = dist * rd;\n        p.z += t; // Forward motion\n        \n        // Apply twist to the tunnel\n        p.xy *= rot(p.z * u_tunnel_twist + t * 0.02);\n        \n        // --- ETHEREAL TURBULENCE (FBM) ---\n        float scale = 1.5;\n        float strength = u_turbulence_strength * (0.8 + bassBoost);\n        for(int j = 0; j < 4; j++) {\n            // Add a shimmer effect based on treble\n            float shimmer = sin(p.x * 10.0 + iTime * 2.0) * u_ethereal_shimmer * 0.1;\n            p += (strength + shimmer) * sin(p.yzx * scale + (t * 0.1)) / scale;\n            scale *= 1.8; \n        }\n        \n        // --- CYLINDRICAL DENSITY ---\n        float radius = u_cloud_height * (2.2 + pulse);\n        float tunnelDist = length(p.xy) - radius;\n        \n        stepSize = 0.12 + (u_density_factor * 0.04);\n        dist += stepSize;\n        \n        // --- COLOR ACCUMULATION ---\n        float angle = atan(p.y, p.x);\n        float hue = (p.z * 0.03 + angle * 0.1) + (u_mid * 0.1);\n        \n        vec3 baseColor = palette(hue);\n        \n        // Soften the walls for that \"cloudy heaven\" look\n        float wallGlow = exp(-abs(tunnelDist) * (5.0 / (u_density_factor + 0.1)));\n        \n        // Atmospheric Fog/God-ray scattering\n        float fog = exp(-dist * u_fog_density * 0.2);\n        float density = wallGlow * (stepSize / (1.0 + dist * 0.1)) * fog;\n        \n        // Injection of \"Golden\" light based on treble\n        vec3 sparkle = vec3(1.0, 0.9, 0.7) * pow(wallGlow, 10.0) * trebleSparkle;\n        \n        col.rgb += (baseColor + sparkle) * density * (u_glow_intensity * 0.5);\n        accumGlow += density;\n\n        if(dist > 30.0 || col.a > 0.99) break;\n    }\n    \n    // --- THE DIVINE LIGHT (GOD RAYS) ---\n    // Simulating light shafts from the center\n    float radial = max(0.0, 1.0 - length(uv));\n    float shafts = pow(radial, 4.0) * u_god_ray_strength;\n    shafts += pow(radial, 20.0) * u_god_ray_strength * 2.0; // Central core\n    \n    float exitGlow = pow(max(0.0, 1.0 - length(uv) / (u_exit_light_size + u_treble * 0.2)), 8.0);\n    vec3 exitColor = vec3(1.0, 0.95, 0.8) * exitGlow * u_exit_light_bright;\n    \n    // --- POST PROCESSING ---\n    vec3 finalCol = col.rgb + exitColor + (shafts * vec3(1.0, 0.98, 0.9));\n    \n    // Bloom\n    finalCol += col.rgb * u_bloom_amount * 0.8;\n    \n    // \"Heavenly\" White-out / Overexposure handling\n    finalCol = smoothstep(-0.05, 1.2, finalCol);\n    finalCol = pow(finalCol, vec3(0.9)); // Slightly lighten gamma\n    finalCol = mix(finalCol, vec3(dot(finalCol, vec3(0.33))), -0.2); // Boost saturation slightly\n    \n    // High-end tone mapping for brightness without crushing\n    finalCol = finalCol / (1.0 + finalCol * 0.15); \n    \n    // Final Dither\n    finalCol += (hash(uv + iTime) - 0.5) * 0.004;\n    \n    // Very subtle vignette (ethereal should be bright)\n    float vignette = 1.0 - dot(uv, uv) * 0.2;\n    finalCol *= vignette;\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
