  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \nuniform sampler2D iChannel1; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; \nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_tunnel_twist; \nuniform float u_exit_light_size; \nuniform float u_exit_light_bright; \n\n// --- ETHEREAL CONTROLS ---\nuniform float u_ethereal_bloom;\nuniform float u_dither_strength; \nuniform float u_cloud_detail;\nuniform float u_cloud_wisps;\n\n// --- FAIRY LIGHT CONTROLS ---\nuniform float u_fairy_light_brightness;\nuniform float u_fairy_light_size;\nuniform float u_fairy_light_count;\nuniform float u_fairy_light_speed;\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\n#define PI 3.14159265359\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat hash12(vec2 p) {\n\tvec3 p3  = fract(vec3(p.xyx) * .1031);\n    p3 += dot(p3, p3.yzx + 33.33);\n    return fract((p3.x + p3.y) * p3.z);\n}\n\nvec3 hash33(vec3 p3) {\n\tp3 = fract(p3 * vec3(.1031, .1030, .0973));\n    p3 += dot(p3, p3.yxz+33.33);\n    return fract((p3.xxy + p3.yxx)*p3.zyx);\n}\n\n// Improved noise sampling for iChannel0\nfloat noise(vec3 p) {\n    vec3 i = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    \n    vec2 uv = (i.xy + vec2(37.0, 17.0) * i.z);\n    vec2 rg = textureLod(iChannel0, (uv + 0.5) / 256.0, 0.0).yx;\n    return mix(rg.x, rg.y, f.z);\n}\n\n// Fractional Brownian Motion\nfloat fbm(vec3 p) {\n    float v = 0.0;\n    float a = 0.5;\n    mat3 m = mat3(0.00, 0.80, 0.60, -0.80, 0.36, -0.48, -0.60, -0.48, 0.64);\n    for (int i = 0; i < 5; i++) {\n        v += a * noise(p);\n        p = m * p * 2.02;\n        a *= 0.5;\n    }\n    return v * u_cloud_detail; \n}\n\n// Fairy Light function using grid-based repetition\nvec3 getFairyLights(vec3 p, float t) {\n    // Grid scale based on count\n    float scale = mix(0.5, 3.0, u_fairy_light_count * 0.1);\n    vec3 p_grid = p * scale;\n    \n    // Adjusted: Reduced the multiplier from 10.0 to 2.0 to significantly slow down approach speed\n    p_grid.z += t * u_fairy_light_speed * 2.0;\n    \n    vec3 id = floor(p_grid);\n    vec3 f = fract(p_grid) - 0.5;\n    \n    // Random offset for each light in its cell\n    vec3 rnd = hash33(id);\n    f -= (rnd - 0.5) * 0.8;\n    \n    float d = length(f);\n    \n    // Flickering effect\n    float flicker = sin(t * 12.0 + rnd.x * 100.0) * 0.5 + 0.5;\n    \n    // Light falloff (ethereal glow)\n    float light = pow(max(0.0, 1.0 - d * (1.0 / u_fairy_light_size)), 4.0) * flicker;\n    // Core of the light\n    float core = exp(-d * (15.0 / u_fairy_light_size)) * flicker;\n    \n    // Dynamic fairy colors (Cyan, Gold, White, Pink)\n    vec3 lCol = mix(vec3(0.5, 0.8, 1.0), vec3(1.0, 0.9, 0.5), rnd.y);\n    lCol = mix(lCol, vec3(1.0, 0.4, 0.8), rnd.z);\n    \n    return lCol * (light + core * 2.0) * u_fairy_light_brightness;\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec3 rd = normalize(vec3(uv, 1.0 / u_fov)); \n    \n    float t = iTime * u_speed;\n    vec4 col = vec4(0.0);\n    \n    float dither = hash12(gl_FragCoord.xy) * u_dither_strength;\n    float dist = u_camera_dist + dither; \n    \n    float stepSize = 0.0;\n    \n    for(int i = 0; i < 80; i++) {\n        vec3 p = dist * rd;\n        vec3 p_world = p; // Store p for fairy lights before tunnel translations\n        p.z += t; \n        \n        p.xy *= rot(p.z * u_tunnel_twist + t * 0.05);\n        \n        // Enhance cloud structure\n        float scale = 1.8;\n        for(int j = 0; j < 3; j++) {\n            p += u_turbulence_strength * 0.5 * sin(p.yzx * scale + t * 0.15) / scale;\n            scale *= 1.8; \n        }\n\n        float wisps = sin(p.x * 4.0 + t) * cos(p.y * 4.0 - t) * u_cloud_wisps;\n        float radius = u_cloud_height * 2.0 + wisps;\n        float tunnelDist = length(p.xy) - radius;\n        \n        float detail = fbm(p * 0.5);\n        tunnelDist -= detail;\n        \n        float stepFactor = max(abs(tunnelDist), 0.015);\n        stepSize = stepFactor * 0.45; \n        dist += stepSize;\n        \n        float angle = atan(p.y, p.x);\n        \n        // Colors\n        vec3 neonPink     = vec3(1.0, 0.2, 0.6); \n        vec3 electricPurple = vec3(0.6, 0.1, 1.0);  \n        vec3 deepIndigo    = vec3(0.1, 0.0, 0.2); \n        \n        float mixVal = sin(p.z * 0.3 + angle + u_color_shift * PI * 2.0) * 0.5 + 0.5;\n        vec3 baseColor = mix(deepIndigo, mix(neonPink, electricPurple, sin(t * 0.4) * 0.5 + 0.5), mixVal);\n        \n        float glow = exp(-abs(tunnelDist) * (8.0 / u_density_factor));\n        float density = smoothstep(0.5, 0.0, abs(tunnelDist));\n        float attenuation = 1.0 / (1.0 + dist * 0.08);\n        \n        vec3 colWithDetail = baseColor * (1.0 + detail * 0.5);\n        \n        // Add cloud color\n        vec3 stepCol = colWithDetail * (glow + density * 0.5) * (u_glow_intensity * 0.12);\n        \n        // Inject Fairy Lights - sampled along the path.\n        vec3 fairyP = p_world;\n        fairyP.xy *= rot(p_world.z * 0.1); // subtle separate rotation for drifting\n        vec3 fairies = getFairyLights(fairyP, iTime);\n        \n        // Blend fairies: They should be brighter than the clouds\n        stepCol += fairies * attenuation; \n        \n        col.rgb += stepCol * attenuation * stepSize;\n        \n        if(col.a > 0.99 || dist > 35.0) break;\n    }\n    \n    // Light at the end\n    float distToCenter = length(uv);\n    float exitGlow = pow(max(0.0, 1.0 - distToCenter / u_exit_light_size), 4.0);\n    vec3 exitColor = vec3(1.0, 0.8, 0.9) * exitGlow * u_exit_light_bright;\n    \n    vec3 finalCol = col.rgb + exitColor;\n    \n    // Ethereal Bloom\n    finalCol += (vec3(0.7, 0.3, 1.0) * u_ethereal_bloom * 0.25) / (1.0 + distToCenter * 3.0);\n    \n    // Tone mapping\n    finalCol = smoothstep(-0.05, 1.5, finalCol);\n    finalCol = pow(finalCol, vec3(0.85)); \n    \n    // Soft Vignette\n    float mask = smoothstep(1.3, 0.4, length(uv));\n    finalCol *= mask;\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
