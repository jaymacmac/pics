  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// User Parameters (Preserved)\nuniform float u_speed;\nuniform float u_fov;\nuniform float u_camera_dist;\nuniform float u_glow_intensity;\nuniform float u_complexity; \nuniform float u_viscosity;\nuniform float u_paper_texture;\nuniform float u_metallic_shine;\nuniform float u_bloom_brightness;\nuniform float u_paint_thickness;\nuniform float u_creaminess;\nuniform float u_melting;\nuniform float u_berry_intensity; \nuniform float u_wave_height;\nuniform float u_orange_hue;\n\nout vec4 fragColor;\n\n// --- UTILS ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat noise(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\n// Multi-tone Palette updated for \"Lush Orange\"\nvec3 getIceCreamPalette(float t, float mask) {\n    // Deep, dark burnt orange for shadows\n    vec3 deepAmber    = vec3(0.25, 0.08, 0.02) * u_berry_intensity; \n    // Vibrant primary orange\n    vec3 lushOrange   = vec3(1.0, 0.45, 0.0) * u_berry_intensity; \n    // Soft creamy peach\n    vec3 peachCream   = vec3(1.0, 0.92, 0.8); \n    \n    // Inject a bit of blood-orange/red richness\n    vec3 redDepth     = vec3(0.5, 0.05, 0.0);\n    \n    float selector = sin(t * 1.5 + mask * 4.0) * 0.5 + 0.5;\n    \n    vec3 finalCol = mix(deepAmber, lushOrange, smoothstep(0.1, 0.7, selector));\n    finalCol = mix(finalCol, peachCream, smoothstep(0.75, 0.98, selector) * u_creaminess);\n    \n    // Inject extra lushness based on the orange shift parameter\n    finalCol = mix(finalCol, redDepth, (1.0 - selector) * u_orange_hue * 0.6);\n    \n    return finalCol;\n}\n\nvoid main() {\n    // 1. Coordinate Setup\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv_orig = uv;\n    \n    // Zoom control\n    uv *= (3.0 - u_fov); \n    \n    float t = iTime * u_speed * 0.15;\n    float r = length(uv);\n    \n    // Removed Vortex Rotation logic\n    vec2 p = uv;\n    \n    float flow = 0.0;\n    \n    // Melt effect: Slight downward drag\n    p.y -= t * u_melting * 0.25;\n    \n    // Wave influence for fractal folding\n    float waveAmp = u_wave_height;\n    \n    for(float i = 1.0; i <= u_complexity; i++) {\n        p.x += (waveAmp / i) * sin(i * 1.8 * p.y + t + u_viscosity * 4.0);\n        p.y += (waveAmp / i) * cos(i * 1.8 * p.x + t + u_viscosity * 4.0);\n        \n        p *= rot(u_camera_dist * 0.04);\n        \n        flow += length(p - uv);\n    }\n    \n    // 3. Distance Fields for the Creamy folds\n    float d = length(sin(p * 0.9)) - 0.45;\n    \n    // Removed Hole masks - everything is fully solid now\n    float mask = smoothstep(1.0 + u_paint_thickness * 0.5, -0.3, d);\n    \n    // Add depth glow\n    float glow = exp(-abs(d) * 4.0) * u_glow_intensity;\n    \n    // 4. Color Compositing\n    vec3 baseCol = getIceCreamPalette(flow * 0.12 + t * 0.15, mask);\n    \n    // Background is now just the fallback deep tone\n    vec3 bgCol = vec3(0.04, 0.01, 0.0); \n    vec3 finalCol = mix(bgCol, baseCol, clamp(mask + glow, 0.0, 1.0));\n    \n    // 5. Glossy Reflections\n    vec3 n = normalize(vec3(dFdx(flow), dFdy(flow), 0.2 / (0.1 + u_wave_height))); \n    vec3 lightDir = normalize(vec3(sin(t * 0.3), 1.0, 1.5));\n    float spec = pow(max(0.0, dot(n, lightDir)), 12.0) * u_metallic_shine;\n    \n    // Highlights are warm golden white\n    vec3 highlight = mix(baseCol, vec3(1.0, 0.98, 0.85), 0.7);\n    finalCol += spec * highlight * u_bloom_brightness;\n    \n    // 6. Surface Texture (Orange Zest/Seeds)\n    float grain = noise(gl_FragCoord.xy * 0.4);\n    if (u_paper_texture > 0.0) {\n        float seedPattern = step(0.98, noise(p * 15.0 + flow));\n        // Seeds are dark brownish-red\n        finalCol = mix(finalCol, vec3(0.15, 0.02, 0.0), seedPattern * u_paper_texture * 3.0);\n        finalCol *= 1.0 - (grain * u_paper_texture * 0.5);\n    }\n\n    // 7. Post Processing\n    float vignette = smoothstep(1.3, 0.4, length(uv_orig));\n    finalCol *= vignette;\n    \n    // Final Toning\n    finalCol = pow(finalCol, vec3(0.9)); \n    finalCol = smoothstep(-0.02, 1.02, finalCol);\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
