  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Expanded Parameter mappings\nuniform float u_speed;         // Animation speed\nuniform float u_scale;         // Zoom / Tissue density\nuniform float u_intensity;     // Overall brightness\nuniform float u_color_cycle;   // Master Hue (0-1)\nuniform float u_layers;        // Complexity of folds\nuniform float u_saturation;    // 0 = B&W, 1 = Vivid\nuniform float u_gloss;         // Surface wetness / Specular intensity\nuniform float u_pulse;         // Heartbeat/breathing strength\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvec2 hash22(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(vec2(p.x * p.y, p.y * p.x)) * 2.0 - 1.0;\n}\n\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    return mix(mix(dot(hash22(i + vec2(0.0,0.0)), f - vec2(0.0,0.0)), \n                   dot(hash22(i + vec2(1.0,0.0)), f - vec2(1.0,0.0)), u.x),\n               mix(dot(hash22(i + vec2(0.0,1.0)), f - vec2(0.0,1.0)), \n                   dot(hash22(i + vec2(1.0,1.0)), f - vec2(1.0,1.0)), u.x), u.y);\n}\n\nfloat fbm(vec2 p) {\n    float v = 0.0, a = 0.5;\n    mat2 m = rot(0.37);\n    for (int i = 0; i < 6; i++) {\n        v += a * noise(p);\n        p = m * p * 2.02;\n        a *= 0.5;\n    }\n    return v;\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n    \n    // Timing and Pulse Connection\n    float spd = (u_speed <= 0.0) ? 0.15 : u_speed * 0.5;\n    float pulse = (u_pulse > 0.0) ? sin(iTime * 3.0) * u_pulse * 0.1 : 0.0;\n    float t = iTime * spd;\n\n    // Background\n    vec3 finalColor = vec3(0.005, 0.002, 0.01); \n    \n    float density = (u_layers <= 0.0) ? 3.0 : u_layers;\n    float scale = ((u_scale <= 0.0) ? 2.5 : u_scale * 3.0) + pulse;\n    float sat = (u_saturation <= 0.0) ? 0.8 : u_saturation;\n    float gloss = (u_gloss <= 0.0) ? 1.0 : u_gloss;\n\n    for(float i = 0.0; i < 4.0; i++) {\n        if(i >= density) break;\n\n        vec2 p = uv * scale * (1.0 + i * 0.2);\n        p += fbm(p + t * 0.3) * 0.5; \n        p *= rot(t * 0.1 + i);\n        \n        float n = fbm(p - t * 0.2); \n        \n        // Hue mapping with organic variation\n        float hue = fract(u_color_cycle + (n * 0.1) - (i * 0.05));\n        \n        // Subsurface Scattering (SSS)\n        vec3 sss = hsv2rgb(vec3(hue, sat, 1.0)) * pow(smoothstep(0.0, 0.6, n), 2.0);\n        \n        // Surface Albedo\n        vec3 albedo = hsv2rgb(vec3(hue, sat * 0.8, 0.4)) * smoothstep(-0.2, 0.5, n);\n        \n        // Specular connected to u_gloss\n        float spec = pow(max(0.0, fbm(p * 2.0 + t)), 12.0) * 2.5 * gloss;\n        vec3 specular = vec3(1.0, 0.98, 1.0) * spec;\n\n        // Ambient Occlusion\n        float ao = smoothstep(-0.4, 0.4, n);\n        \n        vec3 layerColor = (sss + albedo + specular) * ao;\n        float alpha = smoothstep(-0.3, 0.7, n) * (1.0 - i * 0.2);\n        \n        finalColor = mix(finalColor, layerColor, alpha);\n    }\n\n    // Post-Processing\n    finalColor *= smoothstep(1.2, 0.4, length(uv0));\n    finalColor = pow(finalColor * ((u_intensity <= 0.0) ? 1.2 : u_intensity), vec3(1.1)); \n    finalColor = clamp(finalColor, 0.0, 1.0);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
