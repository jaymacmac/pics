  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_glow;\nuniform float u_hue;   // Outer Color\nuniform float u_hue2;  // Inner Color\nuniform float u_twist;\nuniform float u_perspective;\nuniform float u_zoom_curve; // New control for the zoom \"depth\" feel\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\n// HSB to RGB Conversion\nvec3 hsb2rgb(vec3 c) {\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\n// Dual-Hue Palette Logic\nvec3 getLayerColor(float t, float hue1, float hue2) {\n    float h = mix(hue1, hue2, t);\n    float sat = mix(0.9, 0.5, t);\n    float bri = mix(0.5, 1.0, t);\n    return hsb2rgb(vec3(h, sat, bri));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // Convert UV to Polar for Tunnel effect\n    float angle = atan(uv.y, uv.x) / (2.0 * 3.14159); // -0.5 to 0.5\n    float dist = length(uv);\n    \n    // Safety Fallbacks for Params\n    float spd = u_speed;\n    float time = iTime * spd;\n    float scale = u_scale;\n    float glowInt = u_glow;\n    float twist = u_twist;\n    float perspective = max(0.1, u_perspective);\n    \n    float hue1 = u_hue; \n    float hue2 = u_hue2;\n\n    // Background: Deep dark blend\n    vec3 bgCol = hsb2rgb(vec3(mix(hue1, hue2, 0.5), 0.9, 0.015));\n    vec3 finalColor = bgCol;\n\n    // Number of rings in the tunnel\n    const int LAYER_COUNT = 16;\n\n    // Loop for layers: each layer represents a depth step in the tunnel\n    for(int i = 0; i < LAYER_COUNT; i++) {\n        float layerIndex = float(i);\n        \n        // NEVER-ENDING ZOOM LOGIC:\n        // We calculate 'depth' as a cycling progress (0 to 1).\n        // By subtracting time (instead of adding), the layers appear to move towards the viewer (zoom in).\n        float depth = fract(layerIndex / float(LAYER_COUNT) - time * 0.3); \n        \n        // Exponential scaling for the zoom effect:\n        // Small depth values are at the very center (far away), large values are near the screen.\n        // We use power function to create that \"accelerating\" feel of zooming in.\n        float radius = pow(depth, u_zoom_curve) * perspective * 2.5; \n        \n        // Fade layers in at the center (0.0) and out at the edges (1.0) \n        // to create a seamless loop of appearing and disappearing rings.\n        float fade = smoothstep(0.0, 0.25, depth) * smoothstep(1.0, 0.8, depth);\n        \n        // Tunnel Wall coordinate mapping (twist increases as we move through depth)\n        float wallAngle = angle + (1.0 - depth) * twist * 5.0;\n        \n        // --- Wave Logic (Applied to the ring radius) ---\n        // Frequency of waves depends on how deep the ring is\n        float waveFreq = 3.0 + floor(depth * 3.0);\n        float wave = sin(wallAngle * 6.28 * waveFreq + time * 2.0) * 0.04;\n        wave += sin(wallAngle * 6.28 * 7.0 - time) * 0.02;\n        wave *= scale * depth; // Wave intensity grows as it gets closer\n        \n        float ringRadius = radius + wave;\n\n        // Mask: Thickening the rings slightly as they approach\n        float thickness = 0.01 + depth * 0.05;\n        float fillMask = smoothstep(thickness, -thickness, abs(dist - ringRadius));\n        \n        // Edge Glow\n        float edgeDist = abs(dist - ringRadius);\n        float edgeGlow = exp(-edgeDist * (30.0 / (depth + 0.1))) * glowInt;\n\n        // --- Color Logic ---\n        // Inverse depth (1.0 - depth) so the \"far\" rings use hue2 and \"near\" rings use hue1\n        vec3 col = getLayerColor(1.0 - depth, hue1, hue2);\n        \n        // --- Composition ---\n        // Nearer layers get more prominence\n        finalColor += col * fillMask * 0.4 * fade; \n        finalColor += col * edgeGlow * 0.6 * fade; \n    }\n\n    // Central \"void\" focus\n    finalColor *= smoothstep(0.02, 0.4, dist);\n    \n    // Vignette\n    float vignette = smoothstep(1.2, 0.4, length(uv0));\n    finalColor *= vignette;\n    \n    // Tonemapping/Contrast\n    finalColor = pow(finalColor, vec3(0.85));\n    finalColor = smoothstep(-0.05, 1.1, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
