  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Parameter mappings\nuniform float u_speed;         \nuniform float u_scale;         \nuniform float u_intensity;     \nuniform float u_color_cycle;   \nuniform float u_layers;        \nuniform float u_saturation;    \nuniform float u_gloss;         \nuniform float u_pulse;         \n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvec2 hash22(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(vec2(p.x * p.y, p.y * p.x)) * 2.0 - 1.0;\n}\n\nfloat noise(vec2 p) {\n    vec2 i = floor(p);\n    vec2 f = fract(p);\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    return mix(mix(dot(hash22(i + vec2(0.0,0.0)), f - vec2(0.0,0.0)), \n                   dot(hash22(i + vec2(1.0,0.0)), f - vec2(1.0,0.0)), u.x),\n               mix(dot(hash22(i + vec2(0.0,1.0)), f - vec2(0.0,1.0)), \n                   dot(hash22(i + vec2(1.0,1.0)), f - vec2(1.0,1.0)), u.x), u.y);\n}\n\nfloat fbm(vec2 p) {\n    float v = 0.0, a = 0.5;\n    for (int i = 0; i < 6; i++) {\n        v += a * noise(p);\n        p = rot(0.5) * p * 2.1;\n        a *= 0.53;\n    }\n    return v;\n}\n\n// Fixed Heat Palette: Focuses on deep ambers and burnt oranges\nvec3 firePalette(float t, float sat) {\n    // Shifting the curve so \"white\" is much harder to reach\n    vec3 black  = vec3(0.02, 0.0, 0.01);\n    vec3 ember  = vec3(0.4, 0.05, 0.0);\n    vec3 orange = vec3(1.0, 0.35, 0.02);\n    vec3 hot    = vec3(1.0, 0.75, 0.2); // Golden instead of white\n    \n    float h = fract(t + u_color_cycle);\n    \n    vec3 res = mix(black, ember, smoothstep(0.0, 0.2, h));\n    res = mix(res, orange, smoothstep(0.2, 0.5, h));\n    res = mix(res, hot, smoothstep(0.5, 1.0, h));\n    \n    return mix(vec3(dot(res, vec3(0.299, 0.587, 0.114))), res, sat);\n}\n\nvoid main() {\n    v