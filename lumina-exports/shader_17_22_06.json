  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_glow;\nuniform float u_hue;   // Outer Color\nuniform float u_hue2;  // Inner Color\nuniform float u_twist;\nuniform float u_perspective;\nuniform float u_fov_cycle; \nuniform float u_center_brightness; // Control for center light intensity\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\n// HSB to RGB Conversion\nvec3 hsb2rgb(vec3 c) {\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\n// Dual-Hue Palette Logic\nvec3 getLayerColor(float t, float hue1, float hue2) {\n    float h = mix(hue1, hue2, t);\n    float sat = mix(0.9, 0.5, t);\n    float bri = mix(0.5, 1.0, t);\n    return hsb2rgb(vec3(h, sat, bri));\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // Convert UV to Polar for Tunnel effect\n    float angle = atan(uv.y, uv.x) / (2.0 * 3.14159); // -0.5 to 0.5\n    float dist = length(uv);\n    \n    // Safety Fallbacks for Params\n    float spd = (u_speed <= 0.0) ? 0.3 : u_speed;\n    float time = iTime * spd;\n    float scale = u_scale;\n    float glowInt = u_glow;\n    float twist = u_twist;\n    \n    // FOV Logic: cycle from 0.01 to 0.9 and back over 5 minutes (300 seconds)\n    float fovOscillator = 0.5 - 0.5 * cos(iTime * (6.283185 / 300.0));\n    float cyclingPerspective = mix(0.01, 0.9, fovOscillator);\n    \n    // Mix between the manual uniform and the auto-cycling one\n    float perspective = mix(max(0.1, u_perspective), cyclingPerspective, u_fov_cycle);\n    \n    float hue1 = u_hue; \n    float hue2 = u_hue2;\n\n    // Background: Deep dark blend but with a slight base color\n    vec3 bgCol = hsb2rgb(vec3(mix(hue1, hue2, 0.5), 0.7, 0.05));\n    vec3 finalColor = bgCol;\n\n    // Center Light: Filling the \"black hole\" at the center\n    // This creates a glowing core that prevents the center from being pitch black.\n    vec3 centerCoreCol = hsb2rgb(vec3(hue2, 0.6, 1.0));\n    finalColor += centerCoreCol * (exp(-dist * 8.0) * u_center_brightness);\n\n    // Number of rings in the tunnel\n    const int LAYER_COUNT = 12;\n\n    // Loop for layers: each layer represents a depth step in the tunnel\n    for(int i = 0; i < LAYER_COUNT; i++) {\n        float layerIndex = float(i);\n        \n        // SEAMLESS DEPTH LOGIC\n        float depth = fract(layerIndex / float(LAYER_COUNT) + time * 0.2); \n        \n        // Depth mapping\n        float radius = depth * perspective; \n        \n        // Fade layers in at the center and out at the edges\n        float fade = smoothstep(0.0, 0.2, depth) * smoothstep(1.0, 0.7, depth);\n        \n        // Tunnel Wall coordinate mapping\n        float wallAngle = angle + depth * twist;\n        \n        // --- Wave Logic ---\n        float wave = sin(wallAngle * 6.28 * 3.0 + time * 2.0 + layerIndex) * 0.05;\n        wave += sin(wallAngle * 6.28 * 7.0 - time) * 0.02;\n        wave *= scale;\n        \n        float ringRadius = radius + wave;\n\n        // Mask: Are we inside the current ring?\n        float fillMask = smoothstep(0.03, -0.03, dist - ringRadius);\n        \n        // Edge Glow\n        float edgeDist = abs(dist - ringRadius);\n        float edgeGlow = exp(-edgeDist * 20.0) * glowInt;\n\n        // --- Color Logic ---\n        vec3 col = getLayerColor(depth, hue1, hue2);\n        \n        // --- Composition ---\n        finalColor += col * fillMask * 0.15 * fade; \n        finalColor += col * edgeGlow * 0.5 * fade; \n    }\n\n    // REMOVED: finalColor *= smoothstep(0.0, 0.5, dist); \n    // The line above was causing the black center. \n    \n    // Keep subtle edge vignette to maintain focus on center light\n    finalColor *= 1.4 - length(uv0) * 0.6;\n    \n    // Tonemapping/Contrast\n    finalColor = pow(finalColor, vec3(0.95));\n    finalColor = smoothstep(-0.01, 1.02, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
