  "prompt": "Procedural Shader Snapshot",
  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// User Parameters (Preserved)\nuniform float u_speed;\nuniform float u_fov;\nuniform float u_camera_dist;\nuniform float u_glow_intensity;\nuniform float u_complexity; \nuniform float u_viscosity;\nuniform float u_paper_texture;\nuniform float u_metallic_shine;\nuniform float u_bloom_brightness;\nuniform float u_paint_thickness;\nuniform float u_creaminess;\nuniform float u_melting;\n\n// New Parameter for Strawberry Look\nuniform float u_berry_intensity;\n\nout vec4 fragColor;\n\n// --- UTILS ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nfloat noise(vec2 p) {\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\n}\n\n// Multi-tone Palette: Dark Chocolate, Strawberry Pink, and Vanilla Cream\nvec3 getIceCreamPalette(float t, float mask) {\n    vec3 blackChoc   = vec3(0.02, 0.005, 0.01); // Deepest Black/Berry Brown\n    vec3 strawberry  = vec3(1.0, 0.3, 0.55) * u_berry_intensity; // Vibrant Pink\n    vec3 cream       = vec3(1.0, 0.96, 0.94);    // Vanilla/Strawberry Cream\n    \n    // Create a marbled effect\n    float selector = sin(t * 2.0 + mask * 5.0) * 0.5 + 0.5;\n    \n    // Mix Dark Chocolate with Strawberry Pink\n    vec3 finalCol = mix(blackChoc, strawberry, smoothstep(0.2, 0.6, selector));\n    \n    // Swirl in the Cream\n    finalCol = mix(finalCol, cream, smoothstep(0.7, 0.95, selector) * u_creaminess);\n    \n    return finalCol;\n}\n\nvoid main() {\n    // 1. Coordinate Setup\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv_orig = uv;\n    \n    // Zoom control\n    uv *= (3.0 - u_fov); \n    \n    float t = iTime * u_speed * 0.15;\n    \n    // 2. Liquid Distortion (The \"Ice Cream Swirl\")\n    vec2 p = uv;\n    float flow = 0.0;\n    \n    // Melt effect: Slight downward drag\n    p.y -= t * u_melting * 0.2;\n    \n    for(float i = 1.0; i <= u_complexity; i++) {\n        // Distort for viscous ribbon look\n        p.x += (0.4 / i) * sin(i * 2.2 * p.y + t + u_viscosity * 5.0);\n        p.y += (0.4 / i) * cos(i * 2.2 * p.x + t + u_viscosity * 5.0);\n        \n        p *= rot(u_camera_dist * 0.05);\n        \n        flow += length(p - uv);\n    }\n    \n    // 3. Distance Fields for the Creamy folds\n    float d = length(sin(p * 0.8)) - 0.5;\n    \n    // Soft blend for \"Thick\" feel\n    float mask = smoothstep(1.0 + u_paint_thickness * 0.4, -0.2, d);\n    \n    // Add internal depth glow\n    float glow = exp(-abs(d) * 3.0) * u_glow_intensity;\n    \n    // 4. Color Compositing\n    vec3 baseCol = getIceCreamPalette(flow * 0.1 + t * 0.2, mask);\n    \n    // Dark base background logic\n    vec3 finalCol = mix(vec3(0.01, 0.002, 0.005), baseCol, clamp(mask + glow, 0.0, 1.0));\n    \n    // 5. Glossy Reflections (The moisture of melting ice cream)\n    vec3 n = normalize(vec3(dFdx(flow), dFdy(flow), 0.2)); \n    vec3 lightDir = normalize(vec3(sin(t * 0.5), 1.0, 2.0));\n    \n    // Specular highlight (Satin finish)\n    float spec = pow(max(0.0, dot(n, lightDir)), 8.0) * u_metallic_shine;\n    \n    // Bloom tinted by the surface color\n    vec3 highlight = mix(baseCol, vec3(1.0), 0.5);\n    finalCol += spec * highlight * u_bloom_brightness;\n    \n    // 6. Surface Texture (Vanilla bean specks or berry seeds)\n    float grain = noise(gl_FragCoord.xy * 0.2);\n    if (u_paper_texture > 0.0) {\n        // Darker specks like seeds\n        finalCol *= 1.0 - (grain * u_paper_texture * (0.5 + 0.5 * u_creaminess));\n    }\n\n    // 7. Post Processing\n    float vignette = smoothstep(1.2, 0.3, length(uv_orig));\n    finalCol *= vignette;\n    \n    // Richer contrast\n    finalCol = pow(finalCol, vec3(0.95)); \n    finalCol = smoothstep(-0.02, 1.05, finalCol);\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
