  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// Parameter mappings\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_intensity;\nuniform float u_color_cycle;\nuniform float u_layers;\nuniform float u_mood; // Smoothly shifts the pink/purple hues\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\n// 2D Rotation Matrix\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Relaxing Pinks & Purples Palette\n// Sweeps through Orchid, Magenta, Violet, and soft Rose\nvec3 palette(float t, float moodShift) {\n    vec3 a = vec3(0.65, 0.30, 0.65); // Base Pink/Purple\n    vec3 b = vec3(0.45, 0.25, 0.40); // Deep Violet contrast\n    vec3 c = vec3(1.00, 1.00, 1.00); \n    \n    // Mood slider gently offsets the hues along the pink/purple spectrum\n    vec3 d = vec3(0.00, 0.15, 0.35) + moodShift; \n    \n    return a + b * cos(6.28318 * (c * t + d));\n}\n\nvoid main() {\n    // 1. Correct Aspect Ratio UVs\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    vec2 uv0 = uv;\n\n    // 2. Timing\n    float spd = (u_speed <= 0.0) ? 0.2 : u_speed * 0.5;\n    float t = iTime * spd;\n    float currentMood = (u_mood <= -10.0) ? 0.0 : u_mood * 0.5;\n\n    // --- Background (Deep Amethyst Void) ---\n    // A dark, rich background makes the glowing pink petals pop beautifully\n    vec3 bgTop = vec3(0.12, 0.0, 0.18); \n    vec3 bgBottom = vec3(0.02, 0.0, 0.05); \n    vec3 finalColor = mix(bgBottom, bgTop, uv0.y + 0.5 + 0.1 * sin(t * 0.5));\n    \n    // 3. Setup Fractal Math\n    float density = (u_layers <= 0.0) ? 5.0 : u_layers;\n    float scale = (u_scale <= 0.0) ? 1.0 : u_scale;\n    float brightness = (u_intensity <= 0.0) ? 1.5 : u_intensity;\n\n    // Base coordinate to be folded\n    vec2 p = uv * (scale * 2.0);\n    \n    // Smooth, slow global rotation\n    p *= rot(t * 0.1);\n\n    // 4. Fractal Lotus Loop\n    // We fold the space, stretch it, and accumulate the light\n    for(float i = 0.0; i < 7.0; i++) {\n        if(i >= density) break;\n\n        // --- Polar Space Folding (The Kaleidoscope) ---\n        float a = atan(p.y, p.x);\n        float r = length(p);\n        \n        // 6-sided symmetry for the flower petals\n        float sym = 6.0; \n        float segment = 6.28318 / sym;\n        \n        // Fold the angle back on itself to mirror the space\n        a = mod(a + segment / 2.0, segment) - segment / 2.0;\n        \n        // Convert back to cartesian coordinates after folding\n        p = vec2(cos(a), sin(a)) * r;\n        \n        // --- Petal Shape & Fractal Iteration ---\n        // 1. Shift outward: This pushes the center out, creating the overlapping petal effect.\n        // Adding the sine wave makes the flower slowly \"breathe\" open and closed.\n        p.x -= 0.35 + sin(t * 0.8 + i) * 0.05;\n        \n        // 2. Rotate each subsequent layer to create the spiral mandala\n        p *= rot(t * 0.15 + i * 0.8);\n        \n        // 3. Scale up the space for the next recursive petal layer\n        p *= 1.4;\n        \n        // --- Petal Rendering ---\n        // By multiplying p.y by 2.0, we pinch the sides of the glowing circle,\n        // turning it into an elegant, sharp-tipped petal shape.\n        float d = length(p * vec2(1.0, 2.0)); \n        \n        // Intense glowing center, soft atmospheric edges\n        float coreGlow = exp(-d * 6.0) * 0.8; \n        float softGlow = exp(-d * 2.0) * 0.5; \n        \n        // --- Coloring ---\n        float cycle = (u_color_cycle <= 0.0) ? 0.2 : u_color_cycle;\n        // The color maps to the original distance from center (length(uv0)) \n        // to create a gradient that shifts outward through the flower.\n        vec3 col = palette(length(uv0) * 0.4 + i * 0.12 + t * cycle, currentMood);\n\n        // Accumulate the light additively\n        finalColor += col * (coreGlow + softGlow) * brightness * 0.45;\n    }\n\n    // 5. Post-Processing\n    // Heavy, soft vignette to focus the eye on the center of the mandala\n    float vig = 1.0 - length(uv0) * 0.7;\n    finalColor *= vig;\n\n    // Smooth Tone Mapping\n    finalColor = smoothstep(-0.05, 1.2, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}\n\n/* CONFIG\n{\n  \"parameters\": [\n    {\n      \"name\": \"u_mood\",\n      \"label\": \"Purple/Pink Hue Shift\",\n      \"type\": \"float\",\n      \"default\": 0,\n      \"min\": 0,\n      \"max\": 2\n    },\n    {\n      \"name\": \"u_speed\",\n      \"label\": \"Breathing Speed\",\n      \"type\": \"float\",\n      \"default\": 0.2,\n      \"min\": 0,\n      \"max\": 5\n    },\n    {\n      \"name\": \"u_scale\",\n      \"label\": \"Zoom Scale\",\n      \"type\": \"float\",\n      \"default\": 0.8,\n      \"min\": 0.1,\n      \"max\": 5\n    },\n    {\n      \"name\": \"u_intensity\",\n      \"label\": \"Glow Intensity\",\n      \"type\": \"float\",\n      \"default\": 1.5,\n      \"min\": 0,\n      \"max\": 5\n    },\n    {\n      \"name\": \"u_color_cycle\",\n      \"label\": \"Color Cycle\",\n      \"type\": \"float\",\n      \"default\": 0.2,\n      \"min\": -5,\n      \"max\": 5\n    },\n    {\n      \"name\": \"u_layers\",\n      \"label\": \"Petal Layers\",\n      \"type\": \"float\",\n      \"default\": 5.0,\n      \"min\": 1,\n      \"max\": 7\n    }\n  ]\n}\n*/",
