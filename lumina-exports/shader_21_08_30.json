  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\nuniform sampler2D iChannel0;\n\n// User Parameters\nuniform float u_speed;\nuniform float u_scale;\nuniform float u_sparkle;\nuniform float u_glow;\nuniform float u_hue;   // Bottom Color\nuniform float u_hue2;  // Top Color\n\n// New AI Aesthetic Parameters\nuniform float u_neuro_complexity; // Chaos/Fractal detail\nuniform float u_chromatic_aberration; // Color fringing\nuniform float u_bass; // Audio Reactivity (internal or mapped)\nuniform float u_glitch_intensity; // Subtle digital artifacts\n\n// \"Mad\" Parameters\nuniform float u_rage_intensity; // Shaking and jaggedness\nuniform float u_distortion_warp; // Geometry warping\n\nout vec4 fragColor;\n\n// --- Helper Functions ---\n\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// 2D Rotation matrix\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\n// Pseudo-fractal noise for that \"AI/Neural\" look\nfloat fbm(vec2 p) {\n    float v = 0.0;\n    float a = 0.5;\n    vec2 shift = vec2(100.0);\n    for (int i = 0; i < 4; ++i) {\n        v += a * (sin(p.x) + sin(p.y));\n        p = rot(0.5 + u_rage_intensity * 0.2) * p * (2.0 + u_bass) + shift;\n        a *= 0.5;\n    }\n    return v;\n}\n\n// HSB to RGB Conversion\nvec3 hsb2rgb(vec3 c) {\n    vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n    rgb = rgb * rgb * (3.0 - 2.0 * rgb);\n    return c.z * mix(vec3(1.0), rgb, c.y);\n}\n\n// Dual-Hue Palette Logic\nvec3 getLayerColor(int i, float hue1, float hue2) {\n    float t = float(i) / 9.0; \n    float h = mix(hue1, hue2, t);\n    // When \"Mad\", shift towards red/angry tones\n    h = mix(h, 0.0, u_rage_intensity * 0.5); \n    float sat = mix(0.8, 1.0, u_rage_intensity);\n    float bri = mix(0.4, 1.2, t);\n    return hsb2rgb(vec3(h, sat, bri));\n}\n\nfloat getDust(vec2 uv, float t) {\n    float gridSize = 25.0 + u_rage_intensity * 20.0; \n    vec2 id = floor(uv * gridSize);\n    vec2 f = fract(uv * gridSize);\n    float r = hash(id);\n    vec2 pos = vec2(r, fract(r * 12.34));\n    float d = distance(f, pos);\n    float size = 0.03 * (0.5 + 0.5 * sin(t * (5.0 + u_rage_intensity * 10.0) + r * 15.0));\n    return smoothstep(size, size * 0.5, d) * r; \n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    \n    // \"Mad\" Screen Shake\n    float shake = hash(vec2(iTime, 0.0)) * u_rage_intensity * 0.05;\n    uv += vec2(shake, -shake);\n    \n    vec2 uv0 = uv;\n\n    // Safety Fallbacks for Params\n    float spd = (u_speed <= 0.0) ? 0.3 : u_speed;\n    float time = iTime * spd;\n    float scale = (u_scale <= 0.0) ? 1.0 : u_scale;\n    float sparkleInt = (u_sparkle <= 0.0) ? 1.0 : u_sparkle;\n    float glowInt = (u_glow <= 0.0) ? 1.5 : u_glow;\n    \n    // Default Colors\n    float hue1 = (u_hue == 0.0) ? 0.05 : u_hue; \n    float hue2 = (u_hue2 == 0.0) ? 0.75 : u_hue2;\n\n    // Apply Neural Distortions to UV for \"AI Dream\" look\n    float neural = fbm(uv * (3.0 + u_distortion_warp) + time * 0.2) * (u_neuro_complexity + u_rage_intensity);\n    uv += neural * (0.1 + u_distortion_warp * 0.1);\n\n    // Background: Dark blend with a hint of neural noise - shifts redder as rage increases\n    vec3 bgCol = hsb2rgb(vec3(mix(hue1, hue2, 0.5), 0.8 + u_rage_intensity * 0.2, 0.02 + neural * 0.02));\n    vec3 finalColor = bgCol;\n\n    // Chromatic Aberration offsets - amplified by madness\n    float ca = (u_chromatic_aberration + u_rage_intensity * 0.5) * 0.04;\n    \n    // Multi-pass rendering for the layers\n    for(int i = 0; i < 10; i++) {\n        float layerIndex = float(i);\n        \n        // --- Wave Logic with Neural Morphing ---\n        // Frequency increases with madness\n        float freq = (1.5 + layerIndex * 0.1) * (1.0 + u_rage_intensity);\n        float waveHeight = sin(uv.x * freq + time * (1.0 + u_rage_intensity) + layerIndex) * 0.3; \n        \n        // Jagged artifacts added for \"mad\" look\n        waveHeight += abs(sin(uv.x * 20.0 + time * 2.0)) * 0.05 * u_rage_intensity;\n        waveHeight += sin(uv.x * 4.0 - time * 1.2 + layerIndex) * 0.05; \n        \n        // Mix in fbm for \"generative\" fluid movement\n        waveHeight += fbm(vec2(uv.x * 2.0, time * 0.5)) * 0.1 * (u_neuro_complexity + u_rage_intensity);\n        waveHeight *= scale;\n        \n        float yOffset = -0.7 + (layerIndex * 0.15); \n        float surfaceY = waveHeight + yOffset;\n\n        // Mask\n        float fillMask = smoothstep(0.01, -0.01, uv.y - surfaceY);\n        \n        // Glow with simulated chromatic aberration\n        float edgeDist = abs(uv.y - surfaceY);\n        float edgeGlowR = exp(-abs(uv.y - (surfaceY + ca)) * 10.0) * glowInt * (1.0 + u_rage_intensity);\n        float edgeGlowG = exp(-edgeDist * 10.0) * glowInt;\n        float edgeGlowB = exp(-abs(uv.y - (surfaceY - ca)) * 10.0) * glowInt;\n\n        // --- Color Logic ---\n        vec3 col = getLayerColor(i, hue1, hue2);\n        \n        // Add Audio Reactivity\n        col *= (1.0 + u_bass * 0.8);\n        \n        // --- Sparkles ---\n        vec2 dustUV = uv;\n        dustUV.x -= time * 0.1 + (layerIndex * 0.03); \n        float sparkles = getDust(dustUV + vec2(layerIndex, 0.0), time);\n        \n        // --- Composition ---\n        finalColor += col * fillMask * 0.12; \n        finalColor.r += col.r * edgeGlowR * 0.5;\n        finalColor.g += col.g * edgeGlowG * 0.5;\n        finalColor.b += col.b * edgeGlowB * 0.5;\n        \n        vec3 sparkleCol = mix(col, vec3(1.0, 0.2, 0.2), u_rage_intensity);\n        finalColor += sparkleCol * sparkles * fillMask * sparkleInt;\n    }\n\n    // Glitch pulses - much more frequent and violent when mad\n    float glitchRate = 0.98 - u_rage_intensity * 0.1;\n    float glitch = step(glitchRate, hash(vec2(floor(time * (10.0 + u_rage_intensity * 20.0)), 0.0))) * (u_glitch_intensity + u_rage_intensity);\n    finalColor += glitch * vec3(1.0, 0.2, 0.1) * fbm(uv * 40.0);\n\n    // Vignette - tightens when mad\n    finalColor *= (1.2 + u_rage_intensity * 0.5) - length(uv0) * (0.6 + u_rage_intensity * 0.6);\n    \n    // Final AI Polish: Contrast and Tone Mapping\n    // Madness increases contrast\n    finalColor = pow(finalColor, vec3(0.9 - u_rage_intensity * 0.4)); \n    finalColor = smoothstep(-0.05, 1.15 + u_rage_intensity * 0.5, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}\n\n/* CONFIG */\n{\n  \"parameters\": [\n    {\n      \"name\": \"u_hue\",\n      \"label\": \"Bottom Hue\",\n      \"type\": \"float\",\n      \"default\": 0.05,\n      \"min\": 0.0,\n      \"max\": 1.0\n    },\n    {\n      \"name\": \"u_hue2\",\n      \"label\": \"Top Hue\",\n      \"type\": \"float\",\n      \"default\": 0.75,\n      \"min\": 0.0,\n      \"max\": 1.0\n    },\n    {\n      \"name\": \"u_speed\",\n      \"label\": \"Flow Speed\",\n      \"type\": \"float\",\n      \"default\": 0.3,\n      \"min\": 0.0,\n      \"max\": 1.0\n    },\n    {\n      \"name\": \"u_scale\",\n      \"label\": \"Wave Height\",\n      \"type\": \"float\",\n      \"default\": 1.0,\n      \"min\": 0.2,\n      \"max\": 2.0\n    },\n    {\n      \"name\": \"u_sparkle\",\n      \"label\": \"Sparkle Density\",\n      \"type\": \"float\",\n      \"default\": 1.0,\n      \"min\": 0.0,\n      \"max\": 2.0\n    },\n    {\n      \"name\": \"u_glow\",\n      \"label\": \"Edge Glow\",\n      \"type\": \"float\",\n      \"default\": 1.5,\n      \"min\": 0.5,\n      \"max\": 3.0\n    },\n    {\n      \"name\": \"u_neuro_complexity\",\n      \"label\": \"AI Neural Chaos\",\n      \"type\": \"float\",\n      \"default\": 0.5,\n      \"min\": 0.0,\n      \"max\": 2.0\n    },\n    {\n      \"name\": \"u_chromatic_aberration\",\n      \"label\": \"Color Fringing\",\n      \"type\": \"float\",\n      \"default\": 0.4,\n      \"min\": 0.0,\n      \"max\": 2.0\n    },\n    {\n      \"name\": \"u_glitch_intensity\",\n      \"label\": \"Digital Glitch\",\n      \"type\": \"float\",\n      \"default\": 0.2,\n      \"min\": 0.0,\n      \"max\": 1.0\n    },\n    {\n      \"name\": \"u_bass\",\n      \"label\": \"Audio Reactivity\",\n      \"type\": \"float\",\n      \"default\": 0.0,\n      \"min\": 0.0,\n      \"max\": 1.0\n    },\n    {\n      \"name\": \"u_rage_intensity\",\n      \"label\": \"Madness Intensity\",\n      \"type\": \"float\",\n      \"default\": 0.5,\n      \"min\": 0.0,\n      \"max\": 2.0\n    },\n    {\n      \"name\": \"u_distortion_warp\",\n      \"label\": \"Geometry Warp\",\n      \"type\": \"float\",\n      \"default\": 0.5,\n      \"min\": 0.0,\n      \"max\": 3.0\n    }\n  ]\n}",
