  "code": "\n\nuniform float iTime;\nuniform vec2 iResolution;\n\n// User Parameters (Preserved)\nuniform float u_speed;        \nuniform float u_thickness;    \nuniform float u_glow;         \nuniform float u_hue_offset;   \nuniform float u_metalness;    \nuniform float u_gold_mix;     \nuniform float u_frost_amount; \n\n// Neural Parameters\nuniform float u_complexity;   \nuniform float u_pulse_speed;  \n\n// Depth and Hex Parameters\nuniform float u_depth_scale;  \nuniform float u_hex_strength; \n\n// New Neurology/Tech Parameters\nuniform float u_synaptic_firing;\nuniform float u_scanline_alpha;\n\nout vec4 fragColor;\n\n// A smoother rotation helper\nmat2 rot(float a) { return mat2(cos(a), -sin(a), sin(a), cos(a)); }\n\n// Simple pseudo-random hash\nfloat hash(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\n// Hexagonal distance function for flowing hex lines (Tech Interface)\nfloat sdHexagon(vec2 p, float r) {\n    const vec3 k = vec3(-0.866025404, 0.5, 0.577350269);\n    p = abs(p);\n    p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;\n    p -= vec2(clamp(p.x, -k.z * r, k.z * r), r);\n    return length(p) * sign(p.y);\n}\n\n// Color palette - Shifted towards medical/technical cyan and electric blue\nvec3 getNeuralColor(float f, float xPos) {\n    vec3 brainCyan = vec3(0.0, 0.8, 1.0);\n    vec3 deepNeuro = vec3(0.05, 0.1, 0.25);\n    float mixer = clamp(sin(xPos * 0.5 + f * 0.7) * 0.5 + 0.5, 0.0, 1.0);\n    mixer = mix(mixer, 1.0, u_gold_mix); \n    return mix(brainCyan, deepNeuro, mixer);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / min(iResolution.y, iResolution.x);\n    vec2 uv0 = uv;\n\n    float time = iTime * u_speed;\n    vec3 finalColor = vec3(0.0); \n\n    // Neural Depth Layers\n    int layers = 3;\n    for(int layer = 0; layer < layers; layer++) {\n        float lDepth = float(layer + 1);\n        // Parallax effect\n        vec2 pUv = uv * (1.0 + lDepth * 0.4 * u_depth_scale);\n        \n        // Add subtle brain-wave \"EEG\" drift\n        pUv.y += sin(pUv.x * 2.0 + time * 0.5) * 0.05 * lDepth;\n        pUv += vec2(time * 0.1 * lDepth, sin(time * 0.05 * lDepth) * 0.1);\n        \n        // --- HEX GRID BACKGROUND (TECHNICAL INTERFACE) ---\n        vec2 hexUv = pUv * (4.0 + lDepth);\n        vec2 r = vec2(1.0, 1.7320508);\n        vec2 h = r * 0.5;\n        vec2 a = mod(hexUv, r) - h;\n        vec2 b = mod(hexUv - h, r) - h;\n        vec2 gv = dot(a, a) < dot(b, b) ? a : b;\n        \n        float edgeDist = sdHexagon(gv, 0.45);\n        float hexLine = smoothstep(0.02, 0.0, abs(edgeDist) - 0.005); // Sharper technical lines\n        \n        // Flickering tech pulse\n        float hexPulse = step(0.95, sin(time * u_synaptic_firing + lDepth * 2.0 + hash(gv) * 10.0));\n        hexPulse += (sin(edgeDist * 10.0 - time * 2.0 + lDepth) * 0.5 + 0.5) * 0.2;\n        \n        // Add hex contribution\n        vec3 hexCol = getNeuralColor(lDepth, pUv.x) * hexLine * hexPulse * u_hex_strength;\n        finalColor += hexCol / lDepth;\n\n        // --- NEURAL STRANDS (BRAIN WAVES) ---\n        int strands = int(u_complexity) / layers;\n        for(int i = 0; i < strands; i++) {\n            float f = float(i) + lDepth * 10.0;\n            float hsh = hash(vec2(f, f * 0.13));\n            \n            // EEG Waveform logic: combination of sine frequencies to mimic brain activity\n            float wave = sin(pUv.x * (2.0 + hsh) + time * u_synaptic_firing + f) * (0.15 / lDepth);\n            wave += sin(pUv.x * (8.0 * hsh) - time * 1.5) * 0.02; // Fast Beta-wave jitter\n            \n            float yOffset = -1.0 + (2.0 * (float(i) / float(strands))) + sin(time * 0.2 + f) * 0.1;\n            float dist = abs(pUv.y - (wave + yOffset));\n\n            // Synaptic Pulses (Signals traveling down axon)\n            float pulsePos = pUv.x * 2.5 - (iTime * u_pulse_speed * (1.5/lDepth)) + hsh * 20.0;\n            float pulse = pow(max(0.0, sin(pulsePos)), 50.0); // Sharper pulses\n            \n            float thicknessScale = u_thickness * 0.1 * (1.0/lDepth);\n            float core = exp(-dist * (200.0 / thicknessScale)) * 2.5;\n            float glow = exp(-dist * (60.0 / thicknessScale)) * u_glow;\n            \n            vec3 col = getNeuralColor(f, pUv.x + u_hue_offset);\n            \n            // Synaptic Firing / Technical Data \"Noise\"\n            float sparkle = pow(sin(pUv.x * 100.0 + time * 15.0 + f) * 0.5 + 0.5, 20.0) * u_metalness;\n            float frost = hash(pUv * 800.0) * u_frost_amount; // High frequency \"biological\" noise\n\n            vec3 strandColor = col * (core * 2.0 + glow * 0.6);\n            strandColor += vec3(0.5, 0.9, 1.0) * pulse * core * 6.0; // Bright synapse flash\n            strandColor += (sparkle + frost * 0.4) * vec3(0.7, 1.0, 1.0) * core;\n            \n            // Interaction overlay: small square \"data bits\" on the waves\n            float dataBits = step(0.98, hash(vec2(floor(pUv.x * 10.0), floor((pUv.y - wave - yOffset) * 20.0))));\n            strandColor += dataBits * vec3(1.0) * core * 0.5;\n\n            // Blend into final color with depth attenuation\n            finalColor += (strandColor * (1.5 / float(strands))) / (lDepth * 0.8);\n        }\n    }\n\n    // Central \"Core\" Neural Glow\n    float hubGlow = exp(-length(uv0) * 1.5) * 0.3;\n    finalColor += vec3(0.1, 0.4, 0.7) * hubGlow;\n\n    // --- TECHNICAL OVERLAYS ---\n    // Scanlines\n    float scanline = sin(gl_FragCoord.y * 1.5) * 0.1 + 0.9;\n    finalColor *= mix(1.0, scanline, u_scanline_alpha);\n    \n    // Technical CRT vignette\n    float vign = smoothstep(1.6, 0.4, length(uv0));\n    finalColor *= vign;\n    \n    // Chromatic Aberration at edges for \"tech\" feel\n    float distToCenter = length(uv0);\n    finalColor.r *= 1.0 + distToCenter * 0.05;\n    finalColor.b *= 1.0 - distToCenter * 0.05;\n\n    // Tonemapping and Contrast\n    finalColor = pow(finalColor, vec3(0.85)); \n    finalColor = smoothstep(-0.02, 1.15, finalColor);\n    \n    // Spectral depth tint\n    finalColor *= vec3(0.8, 1.0, 1.1);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
