  "code": "uniform float iTime;\nuniform vec2 iResolution;\n\n// User Parameters\nuniform float u_speed;        // Default: 0.25\nuniform float u_thickness;    // Default: 1.5\nuniform float u_glow;         // Default: 1.0\nuniform float u_hue_offset;   // Default: 0.0\nuniform float u_metalness;    // NEW: Controls the chrome reflectivity\nuniform float u_gold_mix;     // NEW: Controls balance between chrome and gold\n\nout vec4 fragColor;\n\n// A smoother rotation helper\nmat2 rot(float a) { return mat2(cos(a), -sin(a), sin(a), cos(a)); }\n\n// Chrome and Gold Palette\n// Instead of fixed purples, we use a logic that interpolates between \n// high-polished silver and rich 24k gold.\nvec3 getChromeGold(int i, float xPos) {\n    // Silver/Chrome base (high value, low saturation)\n    vec3 chrome = vec3(0.85, 0.88, 0.95);\n    // Gold base (Rich yellow-orange)\n    vec3 gold = vec3(1.0, 0.75, 0.2);\n    \n    // Vary the gold/silver mix based on layer index and horizontal position\n    float mixer = clamp(sin(xPos * 2.0 + float(i)) * 0.5 + 0.5, 0.0, 1.0);\n    mixer = mix(mixer, 1.0, u_gold_mix); // User control for gold intensity\n    \n    return mix(chrome, gold, mixer);\n}\n\nvoid main() {\n    // Corrected UVs to maintain aspect ratio\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / min(iResolution.y, iResolution.x);\n    vec2 uv0 = uv;\n\n    float time = iTime * u_speed;\n    // Darker, more \"studio\" background for metallic objects\n    vec3 finalColor = vec3(0.01, 0.01, 0.015); \n\n    // 5 Layers of \"Metallic Ribbons\"\n    for(int i = 0; i < 5; i++) {\n        float f = float(i);\n        \n        // --- WAVE LOGIC ---\n        float wave = sin(uv.x * 1.5 + time + f * 1.5) * 0.2;\n        wave += cos(uv.x * 2.3 - time * 0.7 + f) * 0.1;\n        wave += sin(uv.x * 3.7 + time * 1.2) * 0.05;\n        \n        // Subtle vertical oscillation\n        float yOffset = -0.4 + (f * 0.2) + sin(time * 0.5 + f) * 0.1;\n        \n        // Distance to the wave line\n        float dist = abs(uv.y - (wave + yOffset));\n\n        // --- METALLIC RENDERING ---\n        // Narrower falloff for the \"specular\" core to look like polished metal\n        float bloom = exp(-dist * (15.0 / u_thickness)) * u_glow;\n        float core = exp(-dist * (120.0 / u_thickness)) * 3.0;\n        \n        // Fake reflections: Use a high-frequency sine to simulate environmental highlights\n        float reflection = sin(uv.x * 20.0 + time * 2.0 + f) * 0.5 + 0.5;\n        reflection = pow(reflection, 8.0) * u_metalness;\n        \n        vec3 col = getChromeGold(i, uv.x + u_hue_offset);\n        \n        // Blend in reflections for that chrome look\n        vec3 layerColor = col * (bloom + core);\n        layerColor += reflection * vec3(1.0) * core * u_metalness;\n        \n        // Add layers with additive blending\n        finalColor += layerColor * 0.3;\n    }\n\n    // Add a \"specular floor/ceiling\" reflection\n    finalColor += vec3(0.1, 0.08, 0.05) * exp(-abs(uv0.y) * 1.5);\n\n    // Cinematic vignette\n    float vign = smoothstep(1.6, 0.2, length(uv0));\n    finalColor *= vign;\n    \n    // Tonemapping for metallic punch\n    finalColor = pow(finalColor, vec3(0.8)); // Gamma tweak\n    finalColor = smoothstep(-0.02, 1.2, finalColor);\n\n    fragColor = vec4(finalColor, 1.0);\n}",
