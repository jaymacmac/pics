  "code": "uniform float iTime;\nuniform vec2 iResolution;\nuniform vec4 iMouse;\n\n// --- ASSETS ---\nuniform sampler2D iChannel0; \n\n// --- STANDARD CONTROLS ---\nuniform float u_speed;\nuniform float u_camera_dist; \nuniform float u_fov;\nuniform float u_glow_intensity;\n\n// --- VISUAL CONTROLS ---\nuniform float u_turbulence_strength;\nuniform float u_cloud_height; \nuniform float u_color_shift;\nuniform float u_density_factor;\nuniform float u_saturation;\n\nout vec4 fragColor;\n\n// --- LUMINA MATH LIB ---\nmat2 rot(float a) {\n    float s = sin(a), c = cos(a);\n    return mat2(c, -s, s, c);\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;\n    // rd: Ray direction using provided FOV logic\n    vec3 rd = normalize(vec3(uv, -1.0 / max(0.1, u_fov))); \n    \n    float t = iTime * ((u_speed <= 0.0) ? 0.2 : u_speed);\n    \n    // Accumulation\n    vec4 col = vec4(0.0);\n    \n    // Start distance: offset slightly to ensure we are looking AT the volume\n    float d = 1.0 + u_camera_dist; \n    \n    for(int i = 0; i < 80; i++) {\n        vec3 p = d * rd;\n        \n        // Turbulence Loop: Swizzling and Sine waves for \"Mixing Paint\"\n        float scale = 1.5;\n        vec3 p_orig = p;\n        for(int j = 0; j < 5; j++) {\n            p.xy *= rot(t * 0.05 + float(j) * 0.5);\n            // Swizzling p.yzx for 3D turbulence\n            p += u_turbulence_strength * sin(p.yzx * scale - t) / scale;\n            scale *= 1.7;\n        }\n        \n        // Separation logic: Ridge/Stringy calculation\n        // abs(p.y) creates horizontal \"sheets\" or \"strings\"\n        float strands = u_cloud_height - abs(p.y);\n        \n        // Step size: Smaller steps inside the paint for high-fidelity filaments\n        float stepSize = 0.02 + max(strands, -strands * 0.2) * 0.5;\n        d += stepSize;\n        \n        // Color logic\n        float hue = fract(u_color_shift + p_orig.x * 0.1 + t * 0.05);\n        vec3 pigment = hsv2rgb(vec3(hue, max(0.5, u_saturation), 1.0));\n        \n        // Heat Map: Black -> Red -> Orange -> White (Getty Style)\n        vec3 fireCol = mix(vec3(0.1, 0.0, 0.0), pigment, smoothstep(-0.2, 0.2, strands));\n        \n        // Glow: Exponential density logic from Lumina\n        float glow = exp(strands / (0.15 / max(0.1, u_density_factor)));\n        \n        // Accumulate\n        col.rgb += fireCol * glow * (u_glow_intensity * 0.015);\n        \n        if (col.a > 0.99) break;\n    }\n    \n    // Tone Mapping: Tanh-like compression to handle brightness\n    vec3 finalCol = col.rgb * col.rgb;\n    finalCol = 1.0 - exp(-finalCol * 0.8); // Filmic compression\n    \n    // Final Polish\n    finalCol = pow(finalCol, vec3(1.2, 1.1, 1.0));\n    \n    fragColor = vec4(finalCol, 1.0);\n}",
